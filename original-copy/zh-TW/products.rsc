5:["$","$L18",null,{"categories":[{"id":"all","label":"All","slug":"all"},{"id":"mix-coffee","label":"Mix Coffee","slug":"mix-coffee"},{"id":"non-coffee","label":"Non-Coffee","slug":"non-coffee"},{"id":"snacks","label":"Snacks","slug":"snacks"},{"id":"merchandise","label":"Merchandise","slug":"merchandise"},{"id":"retired-product","label":"Retired Product","slug":"retired-product"}],"displayCategories":[{"id":"mix-coffee","label":"Mix Coffee","slug":"mix-coffee"},{"id":"non-coffee","label":"Non-Coffee","slug":"non-coffee"},{"id":"snacks","label":"Snacks","slug":"snacks"},{"id":"merchandise","label":"Merchandise","slug":"merchandise"},{"id":"retired-product","label":"Retired Product","slug":"retired-product"}],"productsByCategory":{"mix-coffee":[{"id":"f1ad2674-d44d-4f3c-87e0-6998c94fd834","slug":"original-flavor","name":"原味","price":15900,"description":"newmix 的明星主打產品。在韓國人最愛的即溶咖啡為基底，提升了醇厚度與滑順口感，實現了咖啡、糖與奶精的完美平衡。","tastingNote":"甜美、絲滑、堅果香","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/f1ad2674-d44d-4f3c-87e0-6998c94fd834-1774586330859.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/10302017883"},{"label":"amazon","url":"https://a.co/d/021EEdK6"}]},{"id":"394a45e2-841c-4a1b-ad2d-3a3a1c15115d","slug":"roasted-rice-flavor","name":"炒米口味","price":17900,"description":"在韓國，穀物製成的濃香茶飲一直深受大眾喜愛。炒米口味將這種熟悉的穀物香氣融入即溶咖啡中。憑藉其獨特的韓國特色，成為遊客選購韓國紀念品時的超人氣之選。","tastingNote":"穀物香、絲滑、鹹香濃郁","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/394a45e2-841c-4a1b-ad2d-3a3a1c15115d-1774586349920.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/10302297570"},{"label":"amazon","url":"https://a.co/d/0gXNUvJp"}]},{"id":"1a332918-b80a-47e4-a7bf-32c0f6cd6798","slug":"banana-milk-flavor","name":"香蕉牛奶口味","price":17900,"description":"這款產品將韓國經典的「香蕉牛奶」與即溶咖啡完美融合。靈感來自韓國便利商店風靡一時的隱藏菜單——在香蕉牛奶中加入榛果咖啡。也是 newmix 最暢銷且最受歡迎的產品之一。","tastingNote":"香蕉牛奶、絲滑、治癒感","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/1a332918-b80a-47e4-a7bf-32c0f6cd6798-1774586355337.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/11153076618"},{"label":"amazon","url":"https://a.co/d/007KUX0K"}]},{"id":"37e72898-cdf6-4d11-859b-64221248fa52","slug":"matcha-latte-flavor","name":"抹茶拿鐵口味","price":17900,"description":"將抹茶拿鐵與滑順的即溶咖啡相結合。呈現出如同在抹茶拿鐵中加入半份濃縮咖啡般獨特的甜苦平衡。這也是 newmix 獨一無二的口味，抹茶愛好者絕對不容錯過。","tastingNote":"濃郁、回甘、絲滑","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/37e72898-cdf6-4d11-859b-64221248fa52-1774586500730.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/12121386702"},{"label":"amazon","url":"https://a.co/d/0dBhvryW"}]},{"id":"6ba0d0aa-3cb8-44b2-ac11-5bdfd240c1fd","slug":"newmix-air-original-flavor","name":"newmix Air （低糖）原味","price":19900,"description":"這是 newmix 原味的減糖版。保持原有風味的同時，將糖分降至1g。適合追求輕盈口感的顧客。","tastingNote":"輕盈、低糖、香草拿鐵風味","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/6ba0d0aa-3cb8-44b2-ac11-5bdfd240c1fd-1774586549354.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/12048709244"},{"label":"amazon","url":"https://a.co/d/0gjzLHVn"}]},{"id":"72430622-c3c3-4dd7-bbfe-30afafd11c0b","slug":"roasted-chestnut-flavor","name":"烤栗子口味","price":17900,"description":"這款咖啡融合焦香且微甜的烤栗子風味。重現了韓國冬季經典街頭小吃——烤栗子那令人治癒的香氣。寒冷的冬日裡喝上一杯熱騰騰的栗子咖啡，彷彿置身韓國的冬季街頭。","tastingNote":"堅果香、烘烤風味、甜栗子奶油","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/72430622-c3c3-4dd7-bbfe-30afafd11c0b-1774586369276.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/12926205605"}]},{"id":"a24c328c-345a-4aed-a5de-ea2ba32ac78d","slug":"milk-caramel-flavor","name":"焦糖牛奶口味","price":17900,"description":"焦糖牛奶為咖啡增添了如絲絨般順滑的甜美。濃郁的焦糖香氣倍感溫暖，既喚起童年對焦糖零食的美好回憶，又帶給人如同享用高級甜點般的精緻享受。","tastingNote":"絲滑、溫暖、愜意","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/a24c328c-345a-4aed-a5de-ea2ba32ac78d-1774586393795.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://naver.me/FTdTWeHB"}]},{"id":"6c062978-cc0a-47d4-b472-6925aba7efdc","slug":"cinnamon-yakgwa-flavor","name":"肉桂藥果口味","price":17900,"description":"靈感源自韓國傳統甜點「藥果」。它展現了藥果經典的厚實感，風味層次分明。肉桂的點綴與藥果香氣完美結合，增添了高雅且層次豐富的味覺表現。","tastingNote":"肉桂、芳香、韓國傳統甜點","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/6c062978-cc0a-47d4-b472-6925aba7efdc-1774586563465.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":[],"links":[]},{"id":"120a4f1a-46c5-4d93-9859-a416c023d7b0","slug":"mint-chocolate-flavor","name":"薄荷巧克力口味","price":17900,"description":"清涼薄荷、濃郁巧克力與口感圓潤咖啡的完美結合。巧克力的甜味比強烈薄荷味更加突出，即使是不常吃薄荷巧克力的朋友也能輕鬆駕馭。口感溫潤，帶來滿滿幸福感的速溶咖啡。","tastingNote":"薄荷巧克力、清新、極具個性的口味","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/120a4f1a-46c5-4d93-9859-a416c023d7b0.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/12177710170"},{"label":"amazon","url":"https://a.co/d/0aGpGT2O"}]},{"id":"f9fd3997-2c2e-41ab-98eb-03c290bfa816","slug":"melon-ice-cream-flavor","name":"蜜瓜冰淇淋口味","price":19900,"description":"韓國經典哈密瓜冰棒與即溶咖啡絕妙結合，融合出甜美而細膩的蜜瓜風味，宛如記憶中的味道。作為 newmix 招牌夏季口味之一，冷飲風味更佳。","tastingNote":"果香、絲滑、喜悅","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/f9fd3997-2c2e-41ab-98eb-03c290bfa816-1774586410138.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":["Hannam"],"links":[]},{"id":"fe1966df-66b4-4215-b1a0-a65c4fbc321d","slug":"coconut-latte-flavor","name":"椰香拿鐵口味","price":19900,"description":"椰香拿鐵的濃郁與即溶咖啡的柔滑完美結合，入口就是滿滿的熱帶氛圍，椰香控必收，這款飲品一定會成為您的最愛。","tastingNote":"濃郁、絲滑、堅果香","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/fe1966df-66b4-4215-b1a0-a65c4fbc321d-1774586416188.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":["Hannam"],"links":[]},{"id":"fd961a38-c791-401d-98c5-afec355322b4","slug":"strawberry-cream-cheese-flavor","name":"草莓奶油乳酪味","price":19900,"description":"清爽的草莓與滑順的奶油乳酪，與即溶咖啡相遇。綿密的口感在口中緩緩化開，宛如一份精緻的草莓甜點。喜愛草莓甜點的你，一定會愛上這款即溶咖啡。","tastingNote":"Extra Creamy, Bright, Indulgent","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/fd961a38-c791-401d-98c5-afec355322b4-1788401505370.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":["Seongsu"],"links":[]},{"id":"52886a11-84e4-45b7-b0a5-f729e24887bc","slug":"durian-flavor","name":"榴槤風味","price":17900,"description":"這款產品將被譽為「水果之王」的榴槤與即溶咖啡完美融合。保留了榴槤特有的綿密口感，香氣濃郁獨特，一聞便知是榴槤。如果你喜歡榴槤，一定會愛上這款香醇的榴槤即溶咖啡。","tastingNote":"Nutty, Buttery, Savory","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/52886a11-84e4-45b7-b0a5-f729e24887bc-1785229756264.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":true,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/13688012973"}]}],"non-coffee":[{"id":"0698cfb9-4970-4cbd-96eb-35d187a7ceab","slug":"earl-grey-milk-tea","name":"伯爵奶茶","price":17900,"description":"濃郁的伯爵茶搭配柔滑的鮮奶，打造出香醇且細緻的伯爵奶茶，口感順滑、質感高雅，這款不含咖啡的飲品，喜歡茶或奶茶的您一定會喜歡。","tastingNote":"絲絨般順滑、芳香、優雅","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/0698cfb9-4970-4cbd-96eb-35d187a7ceab-1774586284562.webp","categoryId":"d827bec8-0b27-430e-889b-aaf26a4614ff","categorySlug":"non-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/13099616199"}]},{"id":"7bedbcd6-cd00-4fa4-a702-df5256a8b02a","slug":"jasmine-milk-tea","name":"茉莉奶茶","price":17900,"description":"以芬芳的茉莉與香醇鮮奶調製而成的奶茶。花香明亮，甜味淡雅。常喝奶茶的您，值得一試。完全不含咖啡。","tastingNote":"Floral, Fragrant, Silky","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/7bedbcd6-cd00-4fa4-a702-df5256a8b02a-1789790589599.webp","categoryId":"d827bec8-0b27-430e-889b-aaf26a4614ff","categorySlug":"non-coffee","isSeasonal":false,"exclusiveStores":[],"links":[]},{"id":"dbd5e5c0-527c-4c68-a95f-ef8fdf7d7f60","slug":"chocolate-banana","name":"巧克力香蕉","price":17900,"description":"濃郁的巧克力遇上滑順的香蕉牛奶，調出甜點般充滿童趣的一杯。如同杯中的香蕉船，香甜、絲滑，還帶著一絲令人懷念的味道。完全不含咖啡。","tastingNote":"Banana Split, Creamy, Playful","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/dbd5e5c0-527c-4c68-a95f-ef8fdf7d7f60-1777559416015.webp","categoryId":"d827bec8-0b27-430e-889b-aaf26a4614ff","categorySlug":"non-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/13514392963"}]},{"id":"9a1c86ea-745f-4d5c-9187-a63dd8a4d6c0","slug":"hojicha-milk-tea","name":"焙茶奶茶","price":17900,"description":"焙茶的焦香遇上滑順鮮奶，喜歡焙烤風味的您一定會喜歡。天冷時熱飲，天熱時冰飲，四季皆宜。完全不含咖啡。","tastingNote":"Toasty, Nutty, Comforting","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/9a1c86ea-745f-4d5c-9187-a63dd8a4d6c0-1794557716354.webp","categoryId":"d827bec8-0b27-430e-889b-aaf26a4614ff","categorySlug":"non-coffee","isSeasonal":false,"exclusiveStores":[],"links":[]},{"id":"9122324e-e84f-41df-9128-daef07a09f56","slug":"black-misugaru","name":"韓式黑穀飲","price":19900,"description":"以黑豆為基底，融入滿滿香醇穀物，是一款濃郁飽足的穀物拿鐵。不含咖啡，人人都能安心享用。推薦給喜歡醇香風味的您。","tastingNote":"Black Sesame, Nutty, Nourishing","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/9122324e-e84f-41df-9128-daef07a09f56-1794735443456.webp","categoryId":"d827bec8-0b27-430e-889b-aaf26a4614ff","categorySlug":"non-coffee","isSeasonal":false,"exclusiveStores":["Anguk"],"links":[]}],"snacks":[{"id":"526da2be-e974-4bd1-a174-fb23b2b4eda1","slug":"geonobang-crunch","name":"newmix 脆皮麵包餅乾","price":14500,"description":"韓國軍隊經典零食「麵包餅乾」變身為香脆又甜美的點心。香脆口感搭配咖啡與楓糖塗層，讓人愛不釋手。獨立包裝設計，適合與親友分享。","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/snacks/526da2be-e974-4bd1-a174-fb23b2b4eda1-1774586011632.webp","categoryId":"042ea2a1-ffd5-437c-a247-9a70d4c8bef9","categorySlug":"snacks","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/13111214186"}]},{"id":"89a93971-9f39-4d89-9428-b90e0a1aacee","slug":"jeonbyeong-black-sesame","name":"newmix 黑芝麻煎餅","price":15900,"description":"韓國傳統米餅「煎餅」，以酥脆的口感和堅果香氣著稱。這款鹹香輕盈的零食深受各年齡層喜愛，是搭配速溶咖啡的完美選擇。","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/snacks/89a93971-9f39-4d89-9428-b90e0a1aacee-1774585985509.webp","categoryId":"042ea2a1-ffd5-437c-a247-9a70d4c8bef9","categorySlug":"snacks","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/11962509172"}]},{"id":"4f8c13cd-3824-4baf-a5d9-381c9149030a","slug":"jeonbyeong-seaweed","name":"newmix 海苔煎餅","price":15900,"description":"韓國傳統米餅「煎餅」，以酥脆的口感和堅果香氣著稱。這款鹹香輕盈的零食深受各年齡層喜愛，是搭配速溶咖啡的完美選擇。","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/snacks/4f8c13cd-3824-4baf-a5d9-381c9149030a.webp","categoryId":"042ea2a1-ffd5-437c-a247-9a70d4c8bef9","categorySlug":"snacks","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/11962509172"}]}],"merchandise":[{"id":"14f6bba2-ea15-4a04-909f-1c26b0861c43","slug":"ceramic-cup","name":"newmix 陶瓷杯","price":15000,"description":"大家都說用紙杯喝速溶咖啡最香，newmix 以陶瓷材質還原了紙杯造型，專為搭配速溶咖啡而設計。只需將水加至杯內標誌處，即可獲得最完美比例的美味咖啡。","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/merchandise/14f6bba2-ea15-4a04-909f-1c26b0861c43-1774585637209.webp","categoryId":"082cabdf-f9d5-4194-a7a4-c61665e442dc","categorySlug":"merchandise","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/10302373488"}]},{"id":"e3794fbf-dc8c-4d27-b308-b627a6eecbf4","slug":"po-keyring","name":"Po 吊飾","price":18000,"description":"newmix 的吉祥物角色 Po 化身可愛吊飾! Po 的名字和造型靈感源自韓語中代表咖啡條包的「po」。雙手內置磁鐵設計，不僅能自己緊握雙手，還能與其他的 Po 小伙伴牽手互動。","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/merchandise/e3794fbf-dc8c-4d27-b308-b627a6eecbf4-1774585775093.webp","categoryId":"082cabdf-f9d5-4194-a7a4-c61665e442dc","categorySlug":"merchandise","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/13069902548"}]},{"id":"4eb5ab87-5963-4374-868e-15f97621b5a3","slug":"seongsu-tote-bag","name":"newmix 聖水托特包","price":25000,"description":"為 newmix 聖水店專門設計的限量版托特包，僅在聖水店發售。","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/merchandise/4eb5ab87-5963-4374-868e-15f97621b5a3-1774585857023.webp","categoryId":"082cabdf-f9d5-4194-a7a4-c61665e442dc","categorySlug":"merchandise","isSeasonal":false,"exclusiveStores":["Seongsu"],"links":[]},{"id":"6e5401c0-c9df-457d-9dc7-b46dc8f570ea","slug":"bukchon-tote-bag","name":"newmix 北村托特包","price":25000,"description":"為 newmix 北村店專門設計的限量版托特包，僅在北村店發售。","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/merchandise/6e5401c0-c9df-457d-9dc7-b46dc8f570ea.webp","categoryId":"082cabdf-f9d5-4194-a7a4-c61665e442dc","categorySlug":"merchandise","isSeasonal":false,"exclusiveStores":["Anguk"],"links":[]},{"id":"62f81376-9347-4dc6-bb4f-b9fb5b0fab04","slug":"mini-mug-set-for-mix-coffee","name":"速溶咖啡迷你馬克杯套裝","price":25000,"description":"由 Studio Torim 與 newmix 聯名推出，專為沖泡 newmix 而設計的陶瓷套裝。迷你咖啡杯的大小剛好符合水量比例，底盤既可作杯墊，也適合盛放搭配咖啡的小零食。","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/merchandise/62f81376-9347-4dc6-bb4f-b9fb5b0fab04-1774585866261.webp","categoryId":"082cabdf-f9d5-4194-a7a4-c61665e442dc","categorySlug":"merchandise","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/12243341734"}]},{"id":"55b6327d-adbd-4497-a63b-0e47ef101b8b","slug":"maziuntitled-x-newmix-roam-pack","name":"MAZIUNTITLED x newmix 後背包","price":84000,"description":"獻給城市裡的旅人。包袋品牌MAZIUNTITLED攜手newmix,打造一款日常戶外後背包。輕巧好背、百搭實用,通勤旅行都是好夥伴。購買即贈Po鑰匙圈一枚。","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/merchandise/55b6327d-adbd-4497-a63b-0e47ef101b8b-1777428343998.webp","categoryId":"082cabdf-f9d5-4194-a7a4-c61665e442dc","categorySlug":"merchandise","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/12936540338"}]},{"id":"40c47469-a7ba-408e-9a6b-c9b646a65ac1","slug":"maziuntitled-x-newmix-small-post-bag","name":"MAZIUNTITLED x newmix 斜背包","price":69000,"description":"獻給城市裡的旅人。包袋品牌MAZIUNTITLED攜手newmix,打造一款日常斜背包。輕巧好背、百搭實用,通勤旅行都是好夥伴。購買即贈Po鑰匙圈一枚。","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/merchandise/40c47469-a7ba-408e-9a6b-c9b646a65ac1-1777428816710.webp","categoryId":"082cabdf-f9d5-4194-a7a4-c61665e442dc","categorySlug":"merchandise","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/12936544399"}]}],"retired-product":[{"id":"676ff19c-378a-4d29-a7fd-26e92ffea3bb","slug":"red-bean-bingsu-flavor","name":"紅豆刨冰口味","price":15900,"description":"說到「韓國的夏天」，紅豆刨冰是絕對不能錯過的甜點。這款咖啡將紅豆刨冰的風味與速溶咖啡結合，口感甜美且帶有穀物香氣，深受紅豆愛好者喜愛，冷熱皆宜。","tastingNote":"甜紅豆、堅果香、韓國甜點","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/retired-product/676ff19c-378a-4d29-a7fd-26e92ffea3bb-1774586212489.webp","categoryId":"b7b1a47d-dbec-4034-95cb-a5f809297960","categorySlug":"retired-product","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/10739705247"}]},{"id":"42da5a82-108e-4513-8f3c-69953f44cd35","slug":"white-berry-mocha","name":"白莓摩卡口味 (季節限定)","price":0,"description":"2025 年冬季節日限定款。將濃郁絲滑的白巧克力與清爽的樹莓完美融合，呈現出獨特的佳節風味。","tastingNote":"樹莓、白巧克力、節日氛圍","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/retired-product/42da5a82-108e-4513-8f3c-69953f44cd35-1774586217335.webp","categoryId":"b7b1a47d-dbec-4034-95cb-a5f809297960","categorySlug":"retired-product","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/12649574856"}]},{"id":"f2173223-c273-4ddb-8bd7-87a9361079b4","slug":"raspberry-matcha","name":"覆盆子抹茶","price":17900,"description":"濃郁絲滑的抹茶拿鐵搭配清新的覆盆子，打造出別處品嚐不到的特別組合。滿載春日氣息，作為春季限定推出。這是一款非咖啡產品，推薦給喜歡抹茶和清爽口味的朋友。","tastingNote":"Refreshing, Delicate, Lively","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/f2173223-c273-4ddb-8bd7-87a9361079b4-1742134085.webp","categoryId":"b7b1a47d-dbec-4034-95cb-a5f809297960","categorySlug":"retired-product","isSeasonal":true,"exclusiveStores":[],"links":[]},{"id":"cbb6f067-5290-4cc4-83ba-84db0fc41b7a","slug":"taro-milk-tea","name":"芋頭奶茶","price":17900,"description":"這款紫色奶茶融入了香芋醇厚細膩的堅果風味。口感如奶油般絲滑，同時帶有根莖類蔬菜特有的淡雅而深沉的層次感。作為春季限定推出的特別飲品，如甜點般令人愉悅。","tastingNote":"Creamy, Buttery, Nutty","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/cbb6f067-5290-4cc4-83ba-84db0fc41b7a-1773978428609.webp","categoryId":"b7b1a47d-dbec-4034-95cb-a5f809297960","categorySlug":"retired-product","isSeasonal":true,"exclusiveStores":[],"links":[]},{"id":"a7b0cfbb-eb77-460b-80a1-fe0319ed1e2b","slug":"boribori-bar-with-maison-mo-3ea","name":"麥麥棒 with Maison M.O (3入)","price":10000,"description":"攜手高端甜點品牌 Maison M.O 合作推出的甜點。將韓國傳統大麥零食結合優質巧克力。打造出香蕉咖啡、蜜瓜咖啡和鹽味巧克力三種口味，帶來精緻的味蕾體驗。","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/snacks/a7b0cfbb-eb77-460b-80a1-fe0319ed1e2b-1774586001889.webp","categoryId":"b7b1a47d-dbec-4034-95cb-a5f809297960","categorySlug":"retired-product","isSeasonal":false,"exclusiveStores":[],"links":[]},{"id":"f3e12476-cee6-4ed8-8f6e-eb6737c8da54","slug":"lovely-strawberry","name":"甜心草莓","price":17900,"description":"香甜清爽的草莓牛奶，融入真實的草莓果粒。鮮明的果香在口中綻放，搭配滑順的奶香尾韻。完全不含咖啡。","tastingNote":"Strawberry Milk, Refreshing, Cute and Lovely","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/f3e12476-cee6-4ed8-8f6e-eb6737c8da54-1777559195993.webp","categoryId":"b7b1a47d-dbec-4034-95cb-a5f809297960","categorySlug":"retired-product","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/13514065951"}]},{"id":"bbc8fd2a-00c9-4505-8b92-4726eaf2416d","slug":"black-misugaru","name":"韓式黑穀飲","price":17900,"description":"與 INAPSQUARE 合作誕生的口味。以 INAPSQUARE 標誌性的黑白插畫與 newmix 的黑色為靈感打造，是韓國傳統飲品韓式黑穀飲與可愛插畫的相遇。","tastingNote":"Black Sesame, Nutty, Nourishing","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/bbc8fd2a-00c9-4505-8b92-4726eaf2416d-1779156067580.webp","categoryId":"b7b1a47d-dbec-4034-95cb-a5f809297960","categorySlug":"retired-product","isSeasonal":true,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/13527460897"}]},{"id":"86920eb0-dc87-44a2-a692-15ed98d7323b","slug":"birthday-party-vanilla-flavor","name":"生日派對香草口味","price":15900,"description":"以慶生派對上必不可少的經典香草蛋糕為靈感。滑順濃郁的香草香氣，重溫特別之日的喜悅。這款咖啡象徵能與人共享的幸福，特別推薦給喜愛香草拿鐵的顧客。","tastingNote":"香草蛋糕、治癒、慶生與喜悅","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/86920eb0-dc87-44a2-a692-15ed98d7323b-1774586378403.webp","categoryId":"b7b1a47d-dbec-4034-95cb-a5f809297960","categorySlug":"retired-product","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/10739724868"}]},{"id":"676e8e3b-044c-4afe-971c-0be3c0e22bfc","slug":"japangi-milk","name":"自動販賣機牛奶","price":15900,"description":"韓國的自動販賣機曾推出一款被稱為「販賣機牛奶」的飲品，深受不喝咖啡的小朋友及成年人喜愛。newmix 重現了許多韓國人童年記憶中的味道。口感滑順、香甜溫潤。","tastingNote":"甜奶香、懷舊、無咖啡因","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/676e8e3b-044c-4afe-971c-0be3c0e22bfc-1774586262980.webp","categoryId":"b7b1a47d-dbec-4034-95cb-a5f809297960","categorySlug":"retired-product","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"amazon","url":"https://a.co/d/0g18YoRg"}]},{"id":"2774d803-a06a-4dbd-8969-fc1b0861bd2e","slug":"hojicha-milk-tea","name":"焙茶奶茶","price":21900,"description":"與 Noritake 聯名推出的奶茶。焙茶的焦香遇上滑順鮮奶，喜歡香醇烘焙風味的您一定會喜歡。Noritake 包裝為期間限定。完全不含咖啡。","tastingNote":"Toasty, Nutty, Comforting","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/2774d803-a06a-4dbd-8969-fc1b0861bd2e-1790658926194.webp","categoryId":"b7b1a47d-dbec-4034-95cb-a5f809297960","categorySlug":"retired-product","isSeasonal":true,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/13778461332"}]}]},"allProducts":["$5:props:productsByCategory:merchandise:0","$5:props:productsByCategory:snacks:0","$5:props:productsByCategory:retired-product:0","$5:props:productsByCategory:retired-product:1","$5:props:productsByCategory:non-coffee:0","$5:props:productsByCategory:mix-coffee:0","$5:props:productsByCategory:snacks:1","$5:props:productsByCategory:merchandise:1","$5:props:productsByCategory:merchandise:2","$5:props:productsByCategory:mix-coffee:1","$5:props:productsByCategory:snacks:2","$5:props:productsByCategory:non-coffee:1","$5:props:productsByCategory:retired-product:2","$5:props:productsByCategory:retired-product:3","$5:props:productsByCategory:merchandise:3","$5:props:productsByCategory:retired-product:4","$5:props:productsByCategory:mix-coffee:2","$5:props:productsByCategory:retired-product:5","$5:props:productsByCategory:merchandise:4","$5:props:productsByCategory:mix-coffee:3","$5:props:productsByCategory:mix-coffee:4","$5:props:productsByCategory:non-coffee:2","$5:props:productsByCategory:retired-product:6","$5:props:productsByCategory:mix-coffee:5","$5:props:productsByCategory:retired-product:7","$5:props:productsByCategory:retired-product:8","$5:props:productsByCategory:mix-coffee:6","$5:props:productsByCategory:mix-coffee:7","$5:props:productsByCategory:mix-coffee:8","$5:props:productsByCategory:mix-coffee:9","$5:props:productsByCategory:mix-coffee:10","$5:props:productsByCategory:mix-coffee:11","$5:props:productsByCategory
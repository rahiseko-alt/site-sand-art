5:["$","$L18",null,{"categories":[{"id":"all","label":"All","slug":"all"},{"id":"mix-coffee","label":"Mix Coffee","slug":"mix-coffee"},{"id":"non-coffee","label":"Non-Coffee","slug":"non-coffee"},{"id":"snacks","label":"Snacks","slug":"snacks"},{"id":"merchandise","label":"Merchandise","slug":"merchandise"},{"id":"retired-product","label":"Retired Product","slug":"retired-product"}],"displayCategories":[{"id":"mix-coffee","label":"Mix Coffee","slug":"mix-coffee"},{"id":"non-coffee","label":"Non-Coffee","slug":"non-coffee"},{"id":"snacks","label":"Snacks","slug":"snacks"},{"id":"merchandise","label":"Merchandise","slug":"merchandise"},{"id":"retired-product","label":"Retired Product","slug":"retired-product"}],"productsByCategory":{"mix-coffee":[{"id":"f1ad2674-d44d-4f3c-87e0-6998c94fd834","slug":"original-flavor","name":"原味","price":15900,"description":"newmix 的明星主打产品。我们在韩国人最爱的速溶咖啡基础上，提升了醇厚度与丝滑感，实现了咖啡、糖与奶精的完美平衡。","tastingNote":"甜美、丝滑、坚果香","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/f1ad2674-d44d-4f3c-87e0-6998c94fd834-1774586330859.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/10302017883"},{"label":"amazon","url":"https://a.co/d/021EEdK6"}]},{"id":"394a45e2-841c-4a1b-ad2d-3a3a1c15115d","slug":"roasted-rice-flavor","name":"炒米味","price":17900,"description":"在韩国，人们长期以来一直喜爱由谷物制成的浓香茶饮。炒米味将这种熟悉的谷物香气融入速溶咖啡中。凭借其独特的韩国本土特色，成为旅行者选购韩国纪念品时的超人气之选。","tastingNote":"谷物香、丝滑、咸香浓郁","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/394a45e2-841c-4a1b-ad2d-3a3a1c15115d-1774586349920.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/10302297570"},{"label":"amazon","url":"https://a.co/d/0gXNUvJp"}]},{"id":"1a332918-b80a-47e4-a7bf-32c0f6cd6798","slug":"banana-milk-flavor","name":"香蕉牛奶味速溶咖啡","price":17900,"description":"这款产品将韩国标志性的\"香蕉牛奶\"与速溶咖啡完美融合。灵感源自韩国便利店风靡一时的隐藏菜单——在香蕉牛奶中加入榛果咖啡。这是 newmix 最畅销且最受欢迎的产品之一。","tastingNote":"香蕉牛奶、丝滑、治愈感","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/1a332918-b80a-47e4-a7bf-32c0f6cd6798-1774586355337.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/11153076618"},{"label":"amazon","url":"https://a.co/d/007KUX0K"}]},{"id":"37e72898-cdf6-4d11-859b-64221248fa52","slug":"matcha-latte-flavor","name":"抹茶拿铁味速溶咖啡","price":17900,"description":"我们将抹茶拿铁与柔滑的速溶咖啡相结合。它呈现出如同在抹茶拿铁中加入半份浓缩咖啡般独特的甜苦平衡。这是 newmix 独一无二的口味，抹茶爱好者绝对不容错过。","tastingNote":"浓郁、回甘、丝滑","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/37e72898-cdf6-4d11-859b-64221248fa52-1774586500730.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/12121386702"},{"label":"amazon","url":"https://a.co/d/0dBhvryW"}]},{"id":"6ba0d0aa-3cb8-44b2-ac11-5bdfd240c1fd","slug":"newmix-air-original-flavor","name":"newmix Air （低糖）原味","price":19900,"description":"这是 newmix 原味的低糖版。保持原有风味的同时，将糖分降至仅 1g。适合追求轻盈口感的顾客。","tastingNote":"轻盈、低糖、香草拿铁风味","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/6ba0d0aa-3cb8-44b2-ac11-5bdfd240c1fd-1774586549354.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/12048709244"},{"label":"amazon","url":"https://a.co/d/0gjzLHVn"}]},{"id":"72430622-c3c3-4dd7-bbfe-30afafd11c0b","slug":"roasted-chestnut-flavor","name":"烤栗子味","price":17900,"description":"这款咖啡融入了焦香且微甜的烤栗子风味。它捕捉了韩国冬季经典的街头小吃——烤栗子那令人治愈的香气。寒冷的冬日里喝上一杯热腾腾的栗子咖啡，能让您身临其境地感受韩国的冬季氛围。","tastingNote":"坚果香、烘烤风味、甜栗子奶油","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/72430622-c3c3-4dd7-bbfe-30afafd11c0b-1774586369276.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/12926205605"}]},{"id":"a24c328c-345a-4aed-a5de-ea2ba32ac78d","slug":"milk-caramel-flavor","name":"焦糖牛奶味","price":17900,"description":"牛奶焦糖为咖啡注入了如丝绒般顺滑的甜美。深邃的焦糖香气倍感温馨，既让人回想起童年喜爱的焦糖零食，又带给人如同享用高级甜点般的精致体验。","tastingNote":"丝滑、温暖、惬意","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/a24c328c-345a-4aed-a5de-ea2ba32ac78d-1774586393795.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://naver.me/FTdTWeHB"}]},{"id":"6c062978-cc0a-47d4-b472-6925aba7efdc","slug":"cinnamon-yakgwa-flavor","name":"桂皮蜜饯味","price":17900,"description":"灵感源自韩国传统甜点\"药果\"。它捕捉了药果标志性的扎实且富有层次的口感，打造出独一无二的口味。肉桂的点缀与药果香气完美契合，增添了优雅而高级的味觉深度。","tastingNote":"肉桂、芳香、韩国传统甜点","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/6c062978-cc0a-47d4-b472-6925aba7efdc-1774586563465.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":[],"links":[]},{"id":"120a4f1a-46c5-4d93-9859-a416c023d7b0","slug":"mint-chocolate-flavor","name":"薄荷巧克力味","price":17900,"description":"清凉薄荷、浓郁巧克力与柔滑咖啡的巧妙结合。相比薄荷的辛辣，巧克力的甜味更加突出，即使是不常吃薄荷巧克力的朋友也能轻松驾驭。口感宛如热巧克力般温润，是一款极具幸福感的速溶咖啡。","tastingNote":"薄荷巧克力、清新、极具个性的口味","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/120a4f1a-46c5-4d93-9859-a416c023d7b0.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/12177710170"},{"label":"amazon","url":"https://a.co/d/0aGpGT2O"}]},{"id":"f9fd3997-2c2e-41ab-98eb-03c290bfa816","slug":"melon-ice-cream-flavor","name":"哈密瓜冰淇淋味","price":19900,"description":"韩国国民级蜜瓜冰棒与速溶咖啡完美融合。甜美而微妙的蜜瓜风味，正如记忆中的味道。作为 newmix 招牌夏季口味之一，冷饮风味更佳。","tastingNote":"果香、丝滑、喜悦","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/f9fd3997-2c2e-41ab-98eb-03c290bfa816-1774586410138.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":["Hannam"],"links":[]},{"id":"fe1966df-66b4-4215-b1a0-a65c4fbc321d","slug":"coconut-latte-flavor","name":"椰子拿铁味","price":19900,"description":"浓郁丝滑的椰香拿铁与柔滑速溶咖啡相遇，每一口都带来热带风情。如果您喜欢浓郁的椰香，这款产品一定会成为您的最爱。","tastingNote":"浓郁、丝滑、坚果香","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/fe1966df-66b4-4215-b1a0-a65c4fbc321d-1774586416188.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":["Hannam"],"links":[]},{"id":"fd961a38-c791-401d-98c5-afec355322b4","slug":"strawberry-cream-cheese-flavor","name":"草莓奶油奶酪味","price":19900,"description":"清爽的草莓与柔滑的奶油奶酪，与速溶咖啡相遇。绵密的口感在口中缓缓化开，宛如一份精致的草莓甜点。喜爱草莓甜点的你，一定会爱上这款速溶咖啡。","tastingNote":"Extra Creamy, Bright, Indulgent","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/fd961a38-c791-401d-98c5-afec355322b4-1788401505370.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":["Seongsu"],"links":[]},{"id":"52886a11-84e4-45b7-b0a5-f729e24887bc","slug":"durian-flavor","name":"榴莲味","price":17900,"description":"这款产品将被誉为\"水果之王\"的榴莲与速溶咖啡完美融合。我们保留了榴莲特有的绵密口感，香气浓郁独特，一闻便知是榴莲。如果你喜欢榴莲，一定会爱上这款香醇的榴莲速溶咖啡。","tastingNote":"Nutty, Buttery, Savory","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/52886a11-84e4-45b7-b0a5-f729e24887bc-1785229756264.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":true,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/13688012973"}]}],"non-coffee":[{"id":"0698cfb9-4970-4cbd-96eb-35d187a7ceab","slug":"earl-grey-milk-tea","name":"伯爵奶茶","price":17900,"description":"由浓郁伯爵茶与丝滑牛奶制成的醇厚奶茶。如果您喜爱品茶或奶茶，这绝对是您的不二之选。此款产品完全不含咖啡因。","tastingNote":"丝绒般顺滑、芳香、优雅","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/0698cfb9-4970-4cbd-96eb-35d187a7ceab-1774586284562.webp","categoryId":"d827bec8-0b27-430e-889b-aaf26a4614ff","categorySlug":"non-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/13099616199"}]},{"id":"7bedbcd6-cd00-4fa4-a702-df5256a8b02a","slug":"jasmine-milk-tea","name":"茉莉奶茶","price":17900,"description":"以芬芳的茉莉与香醇牛奶调制而成的奶茶。花香明亮，甜味淡雅。常喝奶茶的您，值得一试。完全不含咖啡。","tastingNote":"Floral, Fragrant, Silky","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/7bedbcd6-cd00-4fa4-a702-df5256a8b02a-1789790589599.webp","categoryId":"d827bec8-0b27-430e-889b-aaf26a4614ff","categorySlug":"non-coffee","isSeasonal":false,"exclusiveStores":[],"links":[]},{"id":"dbd5e5c0-527c-4c68-a95f-ef8fdf7d7f60","slug":"chocolate-banana","name":"巧克力香蕉","price":17900,"description":"浓郁的巧克力遇上柔滑的香蕉牛奶，调出甜点般充满童趣的一杯。如同杯中的香蕉船，香甜、丝滑，还带着一丝令人怀念的味道。完全不含咖啡。","tastingNote":"Banana Split, Creamy, Playful","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/dbd5e5c0-527c-4c68-a95f-ef8fdf7d7f60-1777559416015.webp","categoryId":"d827bec8-0b27-430e-889b-aaf26a4614ff","categorySlug":"non-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/13514392963"}]},{"id":"9a1c86ea-745f-4d5c-9187-a63dd8a4d6c0","slug":"hojicha-milk-tea","name":"焙茶奶茶","price":17900,"description":"焙茶的焦香遇上柔滑牛奶，喜欢焙烤风味的您一定会喜欢。天冷时热饮，天热时冰饮，四季皆宜。完全不含咖啡。","tastingNote":"Toasty, Nutty, Comforting","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/9a1c86ea-745f-4d5c-9187-a63dd8a4d6c0-1794557716354.webp","categoryId":"d827bec8-0b27-430e-889b-aaf26a4614ff","categorySlug":"non-coffee","isSeasonal":false,"exclusiveStores":[],"links":[]},{"id":"9122324e-e84f-41df-9128-daef07a09f56","slug":"black-misugaru","name":"韩式黑谷饮","price":19900,"description":"以黑豆为基底，融入满满香醇谷物，是一款浓郁饱足的谷物拿铁。不含咖啡，人人都能安心享用。推荐给喜欢醇香风味的您。","tastingNote":"Black Sesame, Nutty, Nourishing","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/9122324e-e84f-41df-9128-daef07a09f56-1794735443456.webp","categoryId":"d827bec8-0b27-430e-889b-aaf26a4614ff","categorySlug":"non-coffee","isSeasonal":false,"exclusiveStores":["Anguk"],"links":[]}],"snacks":[{"id":"526da2be-e974-4bd1-a174-fb23b2b4eda1","slug":"geonobang-crunch","name":"脆皮饼干","price":14500,"description":"韩国军队经典零食\"干面包\"变身为甜美点心。香脆的干面包包裹着咖啡与枫糖涂层，让人爱不释手。独立包装，方便与亲友分享。","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/snacks/526da2be-e974-4bd1-a174-fb23b2b4eda1-1774586011632.webp","categoryId":"042ea2a1-ffd5-437c-a247-9a70d4c8bef9","categorySlug":"snacks","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/13111214186"}]},{"id":"89a93971-9f39-4d89-9428-b90e0a1aacee","slug":"jeonbyeong-black-sesame","name":"韩国传统煎饼 黑芝麻味","price":15900,"description":"\"煎饼\"是韩国传统米饼，以其松脆的质地和坚果香气而闻名。这款咸香轻盈的零食深受各年龄层喜爱，是搭配速溶咖啡的完美选择。","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/snacks/89a93971-9f39-4d89-9428-b90e0a1aacee-1774585985509.webp","categoryId":"042ea2a1-ffd5-437c-a247-9a70d4c8bef9","categorySlug":"snacks","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/11962509172"}]},{"id":"4f8c13cd-3824-4baf-a5d9-381c9149030a","slug":"jeonbyeong-seaweed","name":"韩国传统煎饼 海苔味","price":15900,"description":"\"煎饼\"是韩国传统米饼，以其松脆的质地和坚果香气而闻名。这款咸香轻盈的零食深受各年龄层喜爱，是搭配速溶咖啡的完美选择。","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/snacks/4f8c13cd-3824-4baf-a5d9-381c9149030a.webp","categoryId":"042ea2a1-ffd5-437c-a247-9a70d4c8bef9","categorySlug":"snacks","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/11962509172"}]}],"merchandise":[{"id":"14f6bba2-ea15-4a04-909f-1c26b0861c43","slug":"ceramic-cup","name":"newmix 陶瓷杯","price":15000,"description":"常言道，用纸杯喝速溶咖啡最香。newmix 以陶瓷材质还原了纸杯造型，大小专为搭配速溶咖啡而设计。只需将水加至杯内标志处，即可获得最完美比例的美味咖啡。","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/merchandise/14f6bba2-ea15-4a04-909f-1c26b0861c43-1774585637209.webp","categoryId":"082cabdf-f9d5-4194-a7a4-c61665e442dc","categorySlug":"merchandise","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/10302373488"}]},{"id":"e3794fbf-dc8c-4d27-b308-b627a6eecbf4","slug":"po-keyring","name":"Po 钥匙扣","price":18000,"description":"newmix 的吉祥物角色 Po 变身为钥匙扣啦。Po 的名字和外形灵感均源自韩语中代表咖啡条包的\"po\"。双手内置磁铁，可以让 Po 紧握双手，或与其他的 Po 小伙伴牵手。","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/merchandise/e3794fbf-dc8c-4d27-b308-b627a6eecbf4-1774585775093.webp","categoryId":"082cabdf-f9d5-4194-a7a4-c61665e442dc","categorySlug":"merchandise","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/13069902548"}]},{"id":"4eb5ab87-5963-4374-868e-15f97621b5a3","slug":"seongsu-tote-bag","name":"圣水限定银色托特包","price":25000,"description":"为 newmix 圣水店专门设计的限量版托特包，仅在圣水店发售。","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/merchandise/4eb5ab87-5963-4374-868e-15f97621b5a3-1774585857023.webp","categoryId":"082cabdf-f9d5-4194-a7a4-c61665e442dc","categorySlug":"merchandise","isSeasonal":false,"exclusiveStores":["Seongsu"],"links":[]},{"id":"6e5401c0-c9df-457d-9dc7-b46dc8f570ea","slug":"bukchon-tote-bag","name":"北村限定托特包","price":25000,"description":"为 newmix 北村店专门设计的限量版托特包，仅在北村店发售。","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/merchandise/6e5401c0-c9df-457d-9dc7-b46dc8f570ea.webp","categoryId":"082cabdf-f9d5-4194-a7a4-c61665e442dc","categorySlug":"merchandise","isSeasonal":false,"exclusiveStores":["Anguk"],"links":[]},{"id":"62f81376-9347-4dc6-bb4f-b9fb5b0fab04","slug":"mini-mug-set-for-mix-coffee","name":"速溶咖啡迷你马克杯套装","price":25000,"description":"由 Studio Torim 与 newmix 联名打造，专为享用 newmix 而设计的陶瓷套装。迷你马克杯的大小契合完美水量比例，底盘既可作杯垫，也适合盛放搭配咖啡的小零食。","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/merchandise/62f81376-9347-4dc6-bb4f-b9fb5b0fab04-1774585866261.webp","categoryId":"082cabdf-f9d5-4194-a7a4-c61665e442dc","categorySlug":"merchandise","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/12243341734"}]},{"id":"55b6327d-adbd-4497-a63b-0e47ef101b8b","slug":"maziuntitled-x-newmix-roam-pack","name":"MAZIUNTITLED x newmix 双肩包","price":84000,"description":"为城市旅人而生。包袋品牌MAZIUNTITLED携手newmix,打造一款日常户外双肩包。轻巧好背、百搭实用,通勤出游都是好搭档。购买即赠Po钥匙扣一枚。","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/merchandise/55b6327d-adbd-4497-a63b-0e47ef101b8b-1777428343998.webp","categoryId":"082cabdf-f9d5-4194-a7a4-c61665e442dc","categorySlug":"merchandise","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/12936540338"}]},{"id":"40c47469-a7ba-408e-9a6b-c9b646a65ac1","slug":"maziuntitled-x-newmix-small-post-bag","name":"MAZIUNTITLED x newmix 斜挎包","price":69000,"description":"为城市旅人而生。包袋品牌MAZIUNTITLED携手newmix,打造一款日常斜挎包。轻巧好背、百搭实用,通勤出游都是好搭档。购买即赠Po钥匙扣一枚。","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/merchandise/40c47469-a7ba-408e-9a6b-c9b646a65ac1-1777428816710.webp","categoryId":"082cabdf-f9d5-4194-a7a4-c61665e442dc","categorySlug":"merchandise","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/12936544399"}]}],"retired-product":[{"id":"676ff19c-378a-4d29-a7fd-26e92ffea3bb","slug":"red-bean-bingsu-flavor","name":"红豆冰沙味","price":15900,"description":"说到\"韩国的夏天\"，红豆冰山是绝不容错过的甜点。这款咖啡将红豆冰山的风味与速溶咖啡相结合，口感甜美且带有谷物香气，深受红豆爱好者喜爱，冷热皆宜。","tastingNote":"甜红豆、坚果香、韩国甜点","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/retired-product/676ff19c-378a-4d29-a7fd-26e92ffea3bb-1774586212489.webp","categoryId":"b7b1a47d-dbec-4034-95cb-a5f809297960","categorySlug":"retired-product","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/10739705247"}]},{"id":"42da5a82-108e-4513-8f3c-69953f44cd35","slug":"white-berry-mocha","name":"白巧莓摩卡味速溶咖啡","price":0,"description":"2025 年冬季节日限定款。将浓郁丝滑的白巧克力与清爽的树莓完美融合，呈现出独特的佳节风味。","tastingNote":"树莓、白巧克力、节日氛围","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/retired-product/42da5a82-108e-4513-8f3c-69953f44cd35-1774586217335.webp","categoryId":"b7b1a47d-dbec-4034-95cb-a5f809297960","categorySlug":"retired-product","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/12649574856"}]},{"id":"f2173223-c273-4ddb-8bd7-87a9361079b4","slug":"raspberry-matcha","name":"覆盆子抹茶","price":17900,"description":"浓郁丝滑的抹茶拿铁搭配清新的覆盆子，打造出别处品尝不到的特别组合。满载春日气息，作为春季限定推出。这是一款非咖啡产品，推荐给喜欢抹茶和清爽口味的朋友。","tastingNote":"Refreshing, Delicate, Lively","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/f2173223-c273-4ddb-8bd7-87a9361079b4-1742134085.webp","categoryId":"b7b1a47d-dbec-4034-95cb-a5f809297960","categorySlug":"retired-product","isSeasonal":true,"exclusiveStores":[],"links":[]},{"id":"cbb6f067-5290-4cc4-83ba-84db0fc41b7a","slug":"taro-milk-tea","name":"芋头奶茶","price":17900,"description":"这款紫色奶茶融入了香芋醇厚细腻的坚果风味。口感如黄油般丝滑，同时带有根茎类蔬菜特有的淡雅而深沉的层次感。作为春季限定推出的特别饮品，如甜点般令人愉悦。","tastingNote":"Creamy, Buttery, Nutty","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/cbb6f067-5290-4cc4-83ba-84db0fc41b7a-1773978428609.webp","categoryId":"b7b1a47d-dbec-4034-95cb-a5f809297960","categorySlug":"retired-product","isSeasonal":true,"exclusiveStores":[],"links":[]},{"id":"a7b0cfbb-eb77-460b-80a1-fe0319ed1e2b","slug":"boribori-bar-with-maison-mo-3ea","name":"波力波力棒 (大麦脆棒) (3只装)","price":10000,"description":"与高端甜点品牌 Maison M.O 合作推出的甜点。将韩国传统大麦零食包裹在优质巧克力中。包含香蕉咖啡、蜜瓜咖啡和盐味巧克力三种口味，带来精致的味蕾体验。","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/snacks/a7b0cfbb-eb77-460b-80a1-fe0319ed1e2b-1774586001889.webp","categoryId":"b7b1a47d-dbec-4034-95cb-a5f809297960","categorySlug":"retired-product","isSeasonal":false,"exclusiveStores":[],"links":[]},{"id":"f3e12476-cee6-4ed8-8f6e-eb6737c8da54","slug":"lovely-strawberry","name":"甜心草莓","price":17900,"description":"香甜清爽的草莓牛奶，融入真实的草莓果粒。鲜明的果香在口中绽放，搭配柔滑的奶香尾韵。完全不含咖啡。","tastingNote":"Strawberry Milk, Refreshing, Cute and Lovely","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/f3e12476-cee6-4ed8-8f6e-eb6737c8da54-1777559195993.webp","categoryId":"b7b1a47d-dbec-4034-95cb-a5f809297960","categorySlug":"retired-product","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/13514065951"}]},{"id":"bbc8fd2a-00c9-4505-8b92-4726eaf2416d","slug":"black-misugaru","name":"韩式黑谷饮","price":17900,"description":"与 INAPSQUARE 合作诞生的口味。以 INAPSQUARE 标志性的黑白插画与 newmix 的黑色为灵感打造，是韩国传统饮品韩式黑谷饮与可爱插画的相遇。","tastingNote":"Black Sesame, Nutty, Nourishing","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/bbc8fd2a-00c9-4505-8b92-4726eaf2416d-1779156067580.webp","categoryId":"b7b1a47d-dbec-4034-95cb-a5f809297960","categorySlug":"retired-product","isSeasonal":true,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/13527460897"}]},{"id":"86920eb0-dc87-44a2-a692-15ed98d7323b","slug":"birthday-party-vanilla-flavor","name":"生日派对香草味速溶咖啡","price":15900,"description":"灵感源自庆生派对上必不可少的经典香草蛋糕。丝滑浓郁的香草香气，带您重温特别之日的喜悦。这款咖啡旨在创造一种能与他人分享的幸福味道，特别推荐给喜爱香草拿铁的顾客。","tastingNote":"香草蛋糕、治愈、庆生与喜悦","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/86920eb0-dc87-44a2-a692-15ed98d7323b-1774586378403.webp","categoryId":"b7b1a47d-dbec-4034-95cb-a5f809297960","categorySlug":"retired-product","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/10739724868"}]},{"id":"676e8e3b-044c-4afe-971c-0be3c0e22bfc","slug":"japangi-milk","name":"甜甜乳(无咖啡因)","price":15900,"description":"韩国的自动贩卖机曾提供一种被称为\"自贩机牛奶\"的饮品。它是深受不喝咖啡的小朋友及成年人喜爱的甜点。newmix 还原了许多韩国人童年记忆中自贩机牛奶的味道。口感顺滑、甜美温润。","tastingNote":"甜奶香、怀旧、无咖啡因","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/676e8e3b-044c-4afe-971c-0be3c0e22bfc-1774586262980.webp","categoryId":"b7b1a47d-dbec-4034-95cb-a5f809297960","categorySlug":"retired-product","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"amazon","url":"https://a.co/d/0g18YoRg"}]},{"id":"2774d803-a06a-
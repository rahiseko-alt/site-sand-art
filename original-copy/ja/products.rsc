5:["$","$L18",null,{"categories":[{"id":"all","label":"All","slug":"all"},{"id":"mix-coffee","label":"Mix Coffee","slug":"mix-coffee"},{"id":"non-coffee","label":"Non-Coffee","slug":"non-coffee"},{"id":"snacks","label":"Snacks","slug":"snacks"},{"id":"merchandise","label":"Merchandise","slug":"merchandise"},{"id":"retired-product","label":"Retired Product","slug":"retired-product"}],"displayCategories":[{"id":"mix-coffee","label":"Mix Coffee","slug":"mix-coffee"},{"id":"non-coffee","label":"Non-Coffee","slug":"non-coffee"},{"id":"snacks","label":"Snacks","slug":"snacks"},{"id":"merchandise","label":"Merchandise","slug":"merchandise"},{"id":"retired-product","label":"Retired Product","slug":"retired-product"}],"productsByCategory":{"mix-coffee":[{"id":"f1ad2674-d44d-4f3c-87e0-6998c94fd834","slug":"original-flavor","name":"オリジナル味","price":15900,"description":"newmixのベストセラーであり、シグネチャーとなる一杯です。韓国で親しまれている甘いミックスコーヒーに、よりなめらかな口当たりを加えました。香ばしい風味が広がり、最後まで飲んでも重たさが残らず、すっきりとした後味を楽しめます。","tastingNote":"甘い味, 香ばしい味, バニララテの味","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/f1ad2674-d44d-4f3c-87e0-6998c94fd834-1774586330859.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/10302017883"},{"label":"amazon","url":"https://a.co/d/021EEdK6"}]},{"id":"394a45e2-841c-4a1b-ad2d-3a3a1c15115d","slug":"roasted-rice-flavor","name":"炒り米味","price":17900,"description":"韓国では古くから、焙煎した穀物を使った香ばしいお茶や飲み物が親しまれてきました。\nそのどこか懐かしい穀物の風味を、ミックスコーヒーとして再解釈。\n韓国らしさを感じられる味わいとして、韓国旅行の思い出になるお土産としても高い人気を誇ります。","tastingNote":"香ばしい味, ユルム茶の味, 満足感のある味","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/394a45e2-841c-4a1b-ad2d-3a3a1c15115d-1774586349920.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/10302297570"},{"label":"amazon","url":"https://a.co/d/0gXNUvJp"}]},{"id":"1a332918-b80a-47e4-a7bf-32c0f6cd6798","slug":"banana-milk-flavor","name":"バナナ牛乳味","price":17900,"description":"韓国を代表する「バナナ牛乳」とミックスコーヒーが出会いました。韓国のコンビニで流行した、バナナ牛乳にヘーゼルナッツコーヒーを加える裏技レシピから着想を得た、newmixの人気メニューです。","tastingNote":"バナナミルク風味, 甘い味, 懐かしい味","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/1a332918-b80a-47e4-a7bf-32c0f6cd6798-1774586355337.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/11153076618"},{"label":"amazon","url":"https://a.co/d/007KUX0K"}]},{"id":"37e72898-cdf6-4d11-859b-64221248fa52","slug":"matcha-latte-flavor","name":"抹茶ラテ味","price":17900,"description":"香ばしい抹茶ラテにまろやかなミックスコーヒーを加えました。エスプレッソをハーフショット加えたような、甘さとほろ苦さが重なる味わいです。newmixだけの抹茶ラテ。抹茶がお好きな方なら、きっと楽しんでいただけます。","tastingNote":"抹茶ラテ味, ほろ苦い, ほのかな甘味","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/37e72898-cdf6-4d11-859b-64221248fa52-1774586500730.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/12121386702"},{"label":"amazon","url":"https://a.co/d/0dBhvryW"}]},{"id":"6ba0d0aa-3cb8-44b2-ac11-5bdfd240c1fd","slug":"newmix-air-original-flavor","name":"newmix Air オリジナル味（低糖）","price":19900,"description":"newmixオリジナルの味わいはそのままに、糖類を1gまで抑えた低糖タイプです。より軽やかにnewmixを楽しみたい方におすすめです。","tastingNote":"甘い味, 香ばしい味, 後味すっきり","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/6ba0d0aa-3cb8-44b2-ac11-5bdfd240c1fd-1774586549354.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/12048709244"},{"label":"amazon","url":"https://a.co/d/0gjzLHVn"}]},{"id":"72430622-c3c3-4dd7-bbfe-30afafd11c0b","slug":"roasted-chestnut-flavor","name":"焼き栗味","price":17900,"description":"香ばしく優しい甘さが特徴の焼き栗風味のミックスコーヒーです。韓国の冬の定番ストリートフード「焼き栗」の温かな香りをそのまま閉じ込めました。口いっぱいに広がる香ばしさと、やわらかな甘さが魅力です。","tastingNote":"モンブラン味, 香ばしい, 冬のおやつ","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/72430622-c3c3-4dd7-bbfe-30afafd11c0b-1774586369276.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/12926205605"}]},{"id":"a24c328c-345a-4aed-a5de-ea2ba32ac78d","slug":"milk-caramel-flavor","name":"ミルクキャラメル味 (聖水店限定)","price":17900,"description":"誰もが親しみのあるミルクキャラメルに、ミックスコーヒーを重ねました。口の中でゆっくりと広がるキャラメルの香りをそのまま再現。懐かしさと上品さをあわせ持つ味わいです。","tastingNote":"ミルクキャラメル味, 甘い味, ダルゴナ味","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/a24c328c-345a-4aed-a5de-ea2ba32ac78d-1774586393795.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://naver.me/FTdTWeHB"}]},{"id":"6c062978-cc0a-47d4-b472-6925aba7efdc","slug":"cinnamon-yakgwa-flavor","name":"シナモン薬菓味 (北村店限定)","price":17900,"description":"韓国の伝統菓子「薬菓（ヤックァ）」に着想を得たフレーバーです。薬菓特有のしっとりとした質感をイメージした、他にはないミックスコーヒーに仕上げました。シナモンの香りが薬菓の風味と重なり、上品で奥行きのある味わいを楽しめます。","tastingNote":"シナモン味, 薬菓味, 韓国おやつ","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/6c062978-cc0a-47d4-b472-6925aba7efdc-1774586563465.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":[],"links":[]},{"id":"120a4f1a-46c5-4d93-9859-a416c023d7b0","slug":"mint-chocolate-flavor","name":"ミントチョコ味","price":17900,"description":"爽やかなミントと濃厚なチョコに、まろやかなコーヒーを重ねました。ミントの清涼感よりもチョコレートの甘みが際立ち、チョコミントが苦手な方にも飲みやすいミックスコーヒーです。","tastingNote":"チョコミント味、チョコレートの甘さ、好みの分かれる個性","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/120a4f1a-46c5-4d93-9859-a416c023d7b0.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/12177710170"},{"label":"amazon","url":"https://a.co/d/0aGpGT2O"}]},{"id":"f9fd3997-2c2e-41ab-98eb-03c290bfa816","slug":"melon-ice-cream-flavor","name":"メロンアイスクリーム味 (期間限定)","price":19900,"description":"韓国の国民的メロンアイスとミックスコーヒーが出会った爽やかなブレンド。記憶の中にある、あの甘くほのかなメロンの風味をそのまま再現しました。newmixの夏を代表する味として、アイスで飲むのが特におすすめです。","tastingNote":"甘い味, メロンアイス風味, なめらかな味","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/f9fd3997-2c2e-41ab-98eb-03c290bfa816-1774586410138.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":["Hannam"],"links":[]},{"id":"fe1966df-66b4-4215-b1a0-a65c4fbc321d","slug":"coconut-latte-flavor","name":"ココナッツラテ味","price":19900,"description":"濃厚でクリーミーなココナッツラテに、ミックスコーヒーをブレンドしました。ココナッツ特有のコクと香ばしさをしっかりと感じられる一杯です。","tastingNote":"濃厚 / クリーミーな味 / ココナッツの香ばしさ","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/fe1966df-66b4-4215-b1a0-a65c4fbc321d-1774586416188.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":["Hannam"],"links":[]},{"id":"fd961a38-c791-401d-98c5-afec355322b4","slug":"strawberry-cream-cheese-flavor","name":"ストロベリークリームチーズ味","price":19900,"description":"爽やかないちごと、なめらかなクリームチーズがミックスコーヒーと出会いました。口いっぱいに広がるクリーミーな口当たりと、上品ないちごのデザートを思わせる味わいです。いちごスイーツがお好きな方なら、きっと気に入っていただける一杯です。","tastingNote":"Extra Creamy, Bright, Indulgent","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/fd961a38-c791-401d-98c5-afec355322b4-1788401505370.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":["Seongsu"],"links":[]},{"id":"52886a11-84e4-45b7-b0a5-f729e24887bc","slug":"durian-flavor","name":"ドリアン味","price":17900,"description":"「果物の王様」と呼ばれるドリアンと、ミックスコーヒーが出会いました。ドリアンならではのクリーミーな味わいを活かし、香りをかいだ瞬間にドリアンだとわかるほど個性の際立つ一杯です。ドリアンがお好きな方なら、香ばしいドリアンミックスコーヒーにきっと夢中になるはずです。","tastingNote":"Nutty, Buttery, Savory","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/52886a11-84e4-45b7-b0a5-f729e24887bc-1785229756264.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":true,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/13688012973"}]}],"non-coffee":[{"id":"0698cfb9-4970-4cbd-96eb-35d187a7ceab","slug":"earl-grey-milk-tea","name":"アールグレイミルクティー","price":17900,"description":"芳醇なアールグレイとクリーミーなミルクで仕上げた、深みのある心温まるミルクティー。お茶やミルクティーが好きな方なら、きっと気に入っていただける味わいです。\nこの製品にはコーヒーが含まれていません。","tastingNote":"まろやかさ / アールグレイの香り / ミルクティーの甘み","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/0698cfb9-4970-4cbd-96eb-35d187a7ceab-1774586284562.webp","categoryId":"d827bec8-0b27-430e-889b-aaf26a4614ff","categorySlug":"non-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/13099616199"}]},{"id":"7bedbcd6-cd00-4fa4-a702-df5256a8b02a","slug":"jasmine-milk-tea","name":"ジャスミンミルクティー","price":17900,"description":"香り高いジャスミンと、まろやかなミルクで仕上げたミルクティーです。華やかな香りと、やさしい甘さが特徴です。ミルクティーをよく飲まれる方におすすめの一杯です。この製品にはコーヒーが含まれていません。","tastingNote":"Floral, Fragrant, Silky","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/7bedbcd6-cd00-4fa4-a702-df5256a8b02a-1789790589599.webp","categoryId":"d827bec8-0b27-430e-889b-aaf26a4614ff","categorySlug":"non-coffee","isSeasonal":false,"exclusiveStores":[],"links":[]},{"id":"dbd5e5c0-527c-4c68-a95f-ef8fdf7d7f60","slug":"chocolate-banana","name":"チョコバナナ","price":17900,"description":"濃厚なチョコレートとまろやかなバナナミルクが出会う、デザートのような遊び心あふれる一杯です。まるでカップに入ったバナナスプリットのように、甘くてなめらかで、どこか懐かしさを感じさせる味わいが広がります。コーヒーは一切使用していない、ノンコーヒータイプです。","tastingNote":"Banana Split, Creamy, Playful","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/dbd5e5c0-527c-4c68-a95f-ef8fdf7d7f60-1777559416015.webp","categoryId":"d827bec8-0b27-430e-889b-aaf26a4614ff","categorySlug":"non-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/13514392963"}]},{"id":"9a1c86ea-745f-4d5c-9187-a63dd8a4d6c0","slug":"hojicha-milk-tea","name":"ほうじ茶ミルクティー","price":17900,"description":"ほうじ茶の香ばしさと、まろやかなミルクが出会いました。香ばしい味わいがお好きな方におすすめの一杯です。寒い季節はホットで、暑い季節はアイスでお楽しみください。この製品にはコーヒーが含まれていません。","tastingNote":"Toasty, Nutty, Comforting","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/9a1c86ea-745f-4d5c-9187-a63dd8a4d6c0-1794557716354.webp","categoryId":"d827bec8-0b27-430e-889b-aaf26a4614ff","categorySlug":"non-coffee","isSeasonal":false,"exclusiveStores":[],"links":[]},{"id":"9122324e-e84f-41df-9128-daef07a09f56","slug":"black-misugaru","name":"ブラックミスカル","price":19900,"description":"香ばしい穀物をたっぷり使った、黒豆ベースの満足感のある穀物ラテです。コーヒーが入っていないので、どなたでも気軽にお楽しみいただけます。香ばしい味わいがお好きな方におすすめです。","tastingNote":"Black Sesame, Nutty, Nourishing","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/9122324e-e84f-41df-9128-daef07a09f56-1794735443456.webp","categoryId":"d827bec8-0b27-430e-889b-aaf26a4614ff","categorySlug":"non-coffee","isSeasonal":false,"exclusiveStores":["Anguk"],"links":[]}],"snacks":[{"id":"526da2be-e974-4bd1-a174-fb23b2b4eda1","slug":"geonobang-crunch","name":"乾パンクランチ","price":14500,"description":"韓国では「軍隊のおやつ」として親しまれている乾パンを、甘いデザートへとアレンジしました。香ばしくサクサクの乾パンに、コーヒーとメープルのコーティングを重ねた、つい手が伸びるスナックです。個包装なので、周りの人と分けやすいのも魅力です。","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/snacks/526da2be-e974-4bd1-a174-fb23b2b4eda1-1774586011632.webp","categoryId":"042ea2a1-ffd5-437c-a247-9a70d4c8bef9","categorySlug":"snacks","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/13111214186"}]},{"id":"89a93971-9f39-4d89-9428-b90e0a1aacee","slug":"jeonbyeong-black-sesame","name":"韓国風せんべい 黒胡麻味","price":15900,"description":"パリッと軽い食感に、黒胡麻の香ばしさが広がる韓国風せんべい。やさしい甘みとコクがあり、ミックスコーヒーともよく合います。幅広い世代に親しまれる味わいです。","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/snacks/89a93971-9f39-4d89-9428-b90e0a1aacee-1774585985509.webp","categoryId":"042ea2a1-ffd5-437c-a247-9a70d4c8bef9","categorySlug":"snacks","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/11962509172"}]},{"id":"4f8c13cd-3824-4baf-a5d9-381c9149030a","slug":"jeonbyeong-seaweed","name":"韓国風せんべい 海苔味","price":15900,"description":"パリッと軽い食感と香ばしさが魅力の韓国風せんべい。海苔の風味がやさしく広がり、ミックスコーヒーとの相性も抜群です。軽やかに楽しめる、つい手が伸びる一枚です。","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/snacks/4f8c13cd-3824-4baf-a5d9-381c9149030a.webp","categoryId":"042ea2a1-ffd5-437c-a247-9a70d4c8bef9","categorySlug":"snacks","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/11962509172"}]}],"merchandise":[{"id":"14f6bba2-ea15-4a04-909f-1c26b0861c43","slug":"ceramic-cup","name":"陶磁器コップ","price":15000,"description":"ミックスコーヒーは紙コップで飲むのが一番美味しい、とよく言われます。newmixはその紙コップのサイズをそのままに、セラミックのコップとして再現しました。コップ内側のロゴのラインまで水を注ぐと、理想的な比率で楽しめます。","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/merchandise/14f6bba2-ea15-4a04-909f-1c26b0861c43-1774585637209.webp","categoryId":"082cabdf-f9d5-4194-a7a4-c61665e442dc","categorySlug":"merchandise","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/10302373488"}]},{"id":"e3794fbf-dc8c-4d27-b308-b627a6eecbf4","slug":"po-keyring","name":"Po(ポ) ぬいぐるみキーホルダー","price":18000,"description":"newmixのマスコットキャラクター「Po（ポ）」のぬいぐるみキーホルダーです。名前も姿も、newmixのコーヒー「ポ（スティック）」から着想を得て生まれました。両手にマグネット入りで、手を合わせたり、他のPoと手をつないだりできます。","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/merchandise/e3794fbf-dc8c-4d27-b308-b627a6eecbf4-1774585775093.webp","categoryId":"082cabdf-f9d5-4194-a7a4-c61665e442dc","categorySlug":"merchandise","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/13069902548"}]},{"id":"4eb5ab87-5963-4374-868e-15f97621b5a3","slug":"seongsu-tote-bag","name":"聖水限定シルバートートバッグ","price":25000,"description":"newmix聖水店限定のトートバッグです。聖水店でのみご購入いただけます。","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/merchandise/4eb5ab87-5963-4374-868e-15f97621b5a3-1774585857023.webp","categoryId":"082cabdf-f9d5-4194-a7a4-c61665e442dc","categorySlug":"merchandise","isSeasonal":false,"exclusiveStores":["Seongsu"],"links":[]},{"id":"6e5401c0-c9df-457d-9dc7-b46dc8f570ea","slug":"bukchon-tote-bag","name":"北村限定ブラックトートバッグ","price":25000,"description":"newmix北村店限定のトートバッグです。北村店でのみご購入いただけます。","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/merchandise/6e5401c0-c9df-457d-9dc7-b46dc8f570ea.webp","categoryId":"082cabdf-f9d5-4194-a7a4-c61665e442dc","categorySlug":"merchandise","isSeasonal":false,"exclusiveStores":["Anguk"],"links":[]},{"id":"62f81376-9347-4dc6-bb4f-b9fb5b0fab04","slug":"mini-mug-set-for-mix-coffee","name":"ミニマグカップセット","price":25000,"description":"Studio Torimとnewmixが共同制作した、「ミックスコーヒーのためのミニマグセット」です。ミニマグは、newmix一杯分の理想的な水量をぴったりと合わせられるようデザインされています。付属のソーサーはマグの受け皿としてはもちろん、コーヒーに合わせるお菓子をのせるプレートとしても使えます。より甘いミックスコーヒータイムをお楽しみください。","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/merchandise/62f81376-9347-4dc6-bb4f-b9fb5b0fab04-1774585866261.webp","categoryId":"082cabdf-f9d5-4194-a7a4-c61665e442dc","categorySlug":"merchandise","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/12243341734"}]},{"id":"55b6327d-adbd-4497-a63b-0e47ef101b8b","slug":"maziuntitled-x-newmix-roam-pack","name":"MAZIUNTITLED x newmix バックパック","price":84000,"description":"街を旅するすべての人へ。バッグブランドMAZIUNTITLEDとnewmixがタッグを組み、毎日使えるアウトドアバックパックが誕生しました。軽くて持ちやすく、どんなシーンにも馴染む一本です。ご購入の方にPoキーリングをプレゼント。","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/merchandise/55b6327d-adbd-4497-a63b-0e47ef101b8b-1777428343998.webp","categoryId":"082cabdf-f9d5-4194-a7a4-c61665e442dc","categorySlug":"merchandise","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/12936540338"}]},{"id":"40c47469-a7ba-408e-9a6b-c9b646a65ac1","slug":"maziuntitled-x-newmix-small-post-bag","name":"MAZIUNTITLED x newmix クロスボディバッグ","price":69000,"description":"街を旅するすべての人へ。バッグブランドMAZIUNTITLEDとnewmixがタッグを組み、毎日使えるクロスボディバッグが誕生しました。軽くて持ちやすく、どんなシーンにも馴染む一本です。ご購入の方にPoキーリングをプレゼント。","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/merchandise/40c47469-a7ba-408e-9a6b-c9b646a65ac1-1777428816710.webp","categoryId":"082cabdf-f9d5-4194-a7a4-c61665e442dc","categorySlug":"merchandise","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/12936544399"}]}],"retired-product":[{"id":"676ff19c-378a-4d29-a7fd-26e92ffea3bb","slug":"red-bean-bingsu-flavor","name":"あずき味","price":15900,"description":"「韓国の夏」といえば欠かせないデザート、あずき入りかき氷\"パッピンス\"。その味わいをミックスコーヒーで表現しました。あずきの香ばしさと、ふわりと広がるやさしい甘さが魅力です。ホットでもアイスでも美味しく楽しめます。","tastingNote":"甘い味, あずきミルク風味, なめらかな味","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/retired-product/676ff19c-378a-4d29-a7fd-26e92ffea3bb-1774586212489.webp","categoryId":"b7b1a47d-dbec-4034-95cb-a5f809297960","categorySlug":"retired-product","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/10739705247"}]},{"id":"42da5a82-108e-4513-8f3c-69953f44cd35","slug":"white-berry-mocha","name":"ホワイトベリーモカ味 (期間限定)","price":0,"description":"2025年冬のホリデーシーズンに合わせて限定発売されたミックスコーヒーです。濃厚なホワイトチョコレートに、爽やかなラズベリーの香りを重ねたユニークな味わい。冬のムードを楽しめるフレーバーとパッケージです。","tastingNote":"ホワイトチョコレート味, ラズベリー味, 冬限定","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/retired-product/42da5a82-108e-4513-8f3c-69953f44cd35-1774586217335.webp","categoryId":"b7b1a47d-dbec-4034-95cb-a5f809297960","categorySlug":"retired-product","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/12649574856"}]},{"id":"f2173223-c273-4ddb-8bd7-87a9361079b4","slug":"raspberry-matcha","name":"ラズベリー抹茶","price":17900,"description":"濃厚でなめらかな抹茶ラテに鮮やかなラズベリーを加え、他では味わえない特別な組み合わせを完成させました。春の息吹をたっぷり詰め込んだ、春限定で発売された一杯です。コーヒー不使用のノンコーヒーラインで、爽やかな味わいと抹茶がお好きな方におすすめです。","tastingNote":"Refreshing, Delicate, Lively","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/f2173223-c273-4ddb-8bd7-87a9361079b4-1742134085.webp","categoryId":"b7b1a47d-dbec-4034-95cb-a5f809297960","categorySlug":"retired-product","isSeasonal":true,"exclusiveStores":[],"links":[]},{"id":"cbb6f067-5290-4cc4-83ba-84db0fc41b7a","slug":"taro-milk-tea","name":"タロミルクティー","price":17900,"description":"タロイモの香ばしくクリーミーな風味が詰まった、紫色のミルクティーです。バターのようになめらかでありながら、根菜ならではのほのかで奥深い味わいも感じられます。春の季節限定で登場した、デザート感覚で楽しめる特別な一杯です。","tastingNote":"Creamy, Buttery, Nutty","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/cbb6f067-5290-4cc4-83ba-84db0fc41b7a-1773978428609.webp","categoryId":"b7b1a47d-dbec-4034-95cb-a5f809297960","categorySlug":"retired-product","isSeasonal":true,"exclusiveStores":[],"links":[]},{"id":"a7b0cfbb-eb77-460b-80a1-fe0319ed1e2b","slug":"boribori-bar-with-maison-mo-3ea","name":"ボリボリバー(麦スナックバー) (3ea)","price":10000,"description":"上質な菓子で知られる「Maison M.O」とのコラボレーションによるデザートです。韓国の伝統的な麦菓子にプレミアムチョコレートをまとわせました。バナナコーヒー、メロンコーヒー、ソルトチョコの3種のフレーバーで、それぞれ異なる味わいを楽しめます。","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/snacks/a7b0cfbb-eb77-460b-80a1-fe0319ed1e2b-1774586001889.webp","categoryId":"b7b1a47d-dbec-4034-95cb-a5f809297960","categorySlug":"retired-product","isSeasonal":false,"exclusiveStores":[],"links":[]},{"id":"f3e12476-cee6-4ed8-8f6e-eb6737c8da54","slug":"lovely-strawberry","name":"ラブリーストロベリー","price":17900,"description":"甘くて爽やかなストロベリーミルクに、本物のいちごの果肉をたっぷり加えました。フルーティーな風味が口いっぱいに広がり、まろやかなミルクの後味でやさしく締めくくられます。コーヒーは一切使用していない、ノンコーヒータイプです。","tastingNote":"Strawberry Milk, Refreshing, Cute and Lovely","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/f3e12476-cee6-4ed8-8f6e-eb6737c8da54-1777559195993.webp","categoryId":"b7b1a47d-dbec-4034-95cb-a5f809297960","categorySlug":"retired-product","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/13514065951"}]},{"id":"bbc8fd2a-00c9-4505-8b92-4726eaf2416d","slug":"black-misugaru","name":"ブラックミスカル","price":17900,"description":"INAPSQUAREとのコラボレーションから生まれた味わいです。INAPSQUAREならではのブラック＆ホワイトのイラストと、newmixのブラックから着想を得て作りました。韓国らしい飲み物「ミスカル」と、かわいいイラストの出会いです。","tastingNote":"Black Sesame, Nutty, Nourishing","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/bbc8fd2a-00c9-4505-8b92-4726eaf2416d-1779156067580.webp","categoryId":"b7b1a47d-dbec-4034-95cb-a5f809297960","categorySlug":"retired-product","isSeasonal":true,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/13527460897"}]},{"id":"86920eb0-dc87-44a2-a692-15ed98d7323b","slug":"birthday-party-vanilla-flavor","name":"バースデーパーティーバニラ味","price":15900,"description":"誕生日に欠かせないクラシックなバニラケーキから着想を得たフレーバーです。なめらかで濃厚なバニラの香りが、特別な日に祝福される喜びを思い起こさせます。お祝いのひとときをみんなで楽しめる味わいをイメージしました。バニララテがお好きな方に特におすすめです。","tastingNote":"ミルキーな味, 甘いクリームの味, バニララテの味","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/86920eb0-dc87-44a2-a692-15ed98d7323b-1774586378403.webp","categoryId":"b7b1a47d-dbec-4034-95cb-a5f809297960","categorySlug":"retired-product","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/10739724868"}]},{"id":"676e8e3b-044c-4afe-971c-0be3c0e22bfc","slug":"japangi-milk","name":"自販機ミルク (甘い牛乳)","price":15900,"description":"韓国の自動販売機には、かつて「自販機ミルク」と呼ばれる甘いミルクドリンクがありました。コーヒーを飲まない子どもから大人まで楽しめる飲み物です。newmixの自販機ミルクは、子どもの頃に自販機で飲んだあの味を再現しました。やさしい甘さとなめらかさが心地よく広がります。","tastingNote":"甘いミルク味, 練乳味, 粉ミルク味","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/676e8e3b-044c-4afe-971c-0be3c0e22bfc-1774586262980.webp","categoryId":"b7b1a47d-dbec-4034-95cb-a5f809297960","categorySlug":"retired-product","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"amazon","url":"https://a.co/d/0g18YoRg"}]},{"id":"2774d803-a06a-4dbd-8969-fc1b0861bd2e","slug":"hojicha-milk-tea","name":"ほうじ茶ミルクティー","price":21900,"description":"Noritakeとのコラボレーションから生まれたミルクティーです。ほうじ茶の香ばしさと、まろやかなミルクが出会いました。香ばしい味わいがお好きな方におすすめです。Noritakeのパッケージは期間限定でお楽しみいただけます。この製品にはコーヒーが含まれていません。","tastingNote":"Toasty, Nutty, Comforting","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffe
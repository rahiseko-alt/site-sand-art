":"온라인에서도 뉴믹스를 만나보세요.","naver":"Store","amazonUs":"Amazon US","comingSoon":"Coming Soon"},"Footer":{"home":"Home","products":"Products","projects":"Projects","store":"Stores","contact":"Contact","behind":"Behind","copyright":"2026 newmix All rights reserved.","termsOfService":"Terms of Service","privacyPolicy":"Privacy Policy","office":"newmix office"},"Meta":{"home":{"title":"newmix","description":"뉴믹스는 한국인에게 익숙한 믹스커피에서 출발해, 익숙한 것들을 섞고 재해석하여 새로움을 만들어가는 브랜드입니다. 제품, 매장, 프로젝트를 만나보세요."},"products":{"title":"Products","description":"믹스커피부터 스낵, 굿즈까지 — 뉴믹스의 전체 제품 라인업을 한눈에 만나보세요."},"projects":{"title":"Projects","description":"뉴믹스가 다양한 브랜드와 함께 진행한 콜라보레이션과 프로젝트를 소개합니다."},"stores":{"title":"Stores","description":"Seongsu, Anguk, Hannam — 서울에서 뉴믹스를 직접 만나볼 수 있는 오프라인 매장 위치와 정보를 안내합니다."},"contact":{"title":"Contact","description":"뉴믹스에 대한 B2B, 협업, 제품 문의를 남겨주세요. 1~2 영업일 이내에 답변드립니다."},"privacy":{"title":"Privacy Policy","description":"뉴믹스가 수집·이용하는 개인정보의 처리 방침을 안내합니다."},"terms":{"title":"Terms of Service","description":"뉴믹스 웹사이트 이용에 관한 약관입니다."}}},"now":"$undefined","timeZone":"UTC","children":[["$","$L13",null,{}],["$","$L14",null,{}],["$","$L15",null,{"children":[["$","$L16",null,{}],["$","$L2",null,{"parallelRouterKey":"children","error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","forbidden":"$undefined","unauthorized":"$undefined"}]]}]]}]

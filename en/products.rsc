10:["$","$L12",null,{"formats":"$undefined","locale":"en","messages":{"Nav":{"products":"Products","projects":"Projects","stores":"Stores","contact":"Contact","behind":"Behind","openMenu":"Open menu","closeMenu":"Close menu"},"Home":{"offlineStore":"Offline Store","offlineStoreDesc":"A must-visit spot in Seoul to taste and experience newmix.","viewAll":"View All","viewLocation":"View Location","previousStore":"Previous store","nextStore":"Next store","contactUs":"Contact Us","contactDesc":"Contact us with any questions or inquiries.","productsTitle":"Products","productsDesc":"Explore all newmix products—from mix coffee to snacks.","brand":{"story":"newmix explores new possibilities <pbr></pbr>by mixing and reinterpreting familiar elements","slogan":"Nothing is new","subslogan":"The new begins with the known.","startWithMix":"Start with mix","coffee":"coffee","kculture":"k-culture","life":"everyday life","journeys":"journeys","rituals":"rituals"}},"Products":{"title":"Products","all":"All"},"Projects":{"title":"Projects"},"Stores":{"title":"Stores"},"Contact":{"title":"Contact","brandDesc":"newmix explores new possibilities <pbr></pbr>by mixing and reinterpreting familiar elements.","brandDescLine1":"newmix explores new possibilities","brandDescLine2":"by mixing and reinterpreting familiar elements.","brandSlogan":"Nothing is new.\nThe new begins with the known.","brandSloganLine1":"Nothing is new.","brandSloganLine2":"The new begins with the known.","startWithMix":"Start with mix","name":"Name *","companyName":"Company name *","email":"E-mail address *","inquiryType":"Tell us what you need help with *","description":"Description *","descriptionPlaceholder":"Please tell us more about your inquiry.","privacyConsent":"[Required] I agree to the privacy policy","send":"Send","sending":"Sending...","b2bInquiries":"B2B Inquiries","productInquiries":"Product Inquiries","collaborationInquiries":"Collaboration Inquiries","generalInquiries":"General Inquiries","errorRequired":
5:["$","$L18",null,{"categories":[{"id":"all","label":"All","slug":"all"},{"id":"mix-coffee","label":"Mix Coffee","slug":"mix-coffee"},{"id":"non-coffee","label":"Non-Coffee","slug":"non-coffee"},{"id":"snacks","label":"Snacks","slug":"snacks"},{"id":"merchandise","label":"Merchandise","slug":"merchandise"},{"id":"retired-product","label":"Retired Product","slug":"retired-product"}],"displayCategories":[{"id":"mix-coffee","label":"Mix Coffee","slug":"mix-coffee"},{"id":"non-coffee","label":"Non-Coffee","slug":"non-coffee"},{"id":"snacks","label":"Snacks","slug":"snacks"},{"id":"merchandise","label":"Merchandise","slug":"merchandise"},{"id":"retired-product","label":"Retired Product","slug":"retired-product"}],"productsByCategory":{"mix-coffee":[{"id":"f1ad2674-d44d-4f3c-87e0-6998c94fd834","slug":"original-flavor","name":"Original Flavor","price":15900,"description":"Original Flavor is newmix's bestselling and signature product. We added extra richness and smoothness to Korea's favorite mix coffee, creating a well-balanced blend of coffee, sugar, and cream.","tastingNote":"Sweet, Creamy, Nutty","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/f1ad2674-d44d-4f3c-87e0-6998c94fd834-1774586330859.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/10302017883"},{"label":"amazon","url":"https://a.co/d/021EEdK6"}]},{"id":"394a45e2-841c-4a1b-ad2d-3a3a1c15115d","slug":"roasted-rice-flavor","name":"Roasted Rice Flavor","price":17900,"description":"In Korea, people have long enjoyed nutty, grain-based teas and beverages made from roasted grains.\nRoasted Rice Flavor captures this familiar nutty grain taste in a mix coffee.\nWith its distinctly Korean character, it's a highly popular choice for travelers looking for a memorable Korean souvenir.","tastingNote":"Nutty, Creamy, Savory","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/394a45e2-841c-4a1b-ad2d-3a3a1c15115d-1774586349920.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/10302297570"},{"label":"amazon","url":"https://a.co/d/0gXNUvJp"}]},{"id":"1a332918-b80a-47e4-a7bf-32c0f6cd6798","slug":"banana-milk-flavor","name":"Banana Milk Flavor","price":17900,"description":"This blend combines Korea's iconic banana milk with mix coffee.\nIt was inspired by a popular trend in Korean convenience stores, where hazelnut coffee is added to banana milk to create a surprisingly delicious combination.\nIt's one of the best-selling and most popular products from newmix.","tastingNote":"Banana Milk, Creamy, Comforting","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/1a332918-b80a-47e4-a7bf-32c0f6cd6798-1774586355337.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/11153076618"},{"label":"amazon","url":"https://a.co/d/007KUX0K"}]},{"id":"37e72898-cdf6-4d11-859b-64221248fa52","slug":"matcha-latte-flavor","name":"Matcha Latte Flavor","price":17900,"description":"We blended a matcha latte with smooth mix coffee. It delivers the unique balance of sweetness and gentle bitterness you'd get by adding half a shot of espresso to a matcha latte.\nThis is newmix's one-of-a-kind matcha latte, found nowhere else. If you love matcha, this is a flavor you'll absolutely enjoy.","tastingNote":"Rich, Bitter-Sweet, Creamy","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/37e72898-cdf6-4d11-859b-64221248fa52-1774586500730.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/12121386702"},{"label":"amazon","url":"https://a.co/d/0dBhvryW"}]},{"id":"6ba0d0aa-3cb8-44b2-ac11-5bdfd240c1fd","slug":"newmix-air-original-flavor","name":"newmix Air Original Flavor","price":19900,"description":"This is a lower-sugar version of newmix Original Flavor. The flavor stays the same, but the sugar has been reduced to just 1g.\nPerfect for those who want a lighter newmix.","tastingNote":"Light, Low Sugar, Vanilla Latte","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/6ba0d0aa-3cb8-44b2-ac11-5bdfd240c1fd-1774586549354.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/12048709244"},{"label":"amazon","url":"https://a.co/d/0gjzLHVn"}]},{"id":"72430622-c3c3-4dd7-bbfe-30afafd11c0b","slug":"roasted-chestnut-flavor","name":"Roasted Chestnut Flavor","price":17900,"description":"This mix coffee features a roasted chestnut flavor that's toasty and gently sweet.\nIt captures the comforting aroma of roasted chestnuts, a beloved classic winter street snack in Korea.\nDelicious anytime, but when enjoyed warm on a cold winter day, it lets you experience the true feeling of winter in Korea.","tastingNote":"Nutty, Toasty, Sweet Chestnut Cream","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/72430622-c3c3-4dd7-bbfe-30afafd11c0b-1774586369276.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/12926205605"}]},{"id":"a24c328c-345a-4aed-a5de-ea2ba32ac78d","slug":"milk-caramel-flavor","name":"Milk Caramel Flavor","price":17900,"description":"Milk Caramel adds a sweet, velvety richness to the mix coffee. The deep caramel aroma feels warm and cozy. It recalls the sweet caramel treats enjoyed in childhood, while also offering the indulgent feel of a sophisticated dessert.","tastingNote":"Creamy, Warm, Cozy","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/a24c328c-345a-4aed-a5de-ea2ba32ac78d-1774586393795.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://naver.me/FTdTWeHB"}]},{"id":"6c062978-cc0a-47d4-b472-6925aba7efdc","slug":"cinnamon-yakgwa-flavor","name":"Cinnamon Yakgwa Flavor","price":17900,"description":"This flavor was inspired by yakgwa, a traditional Korean dessert. It captures yakgwa's signature dense, chewy texture, creating a truly unique mix coffee you won't find anywhere else.\nA touch of cinnamon, perfectly paired with the aroma of yakgwa, adds a refined and luxurious depth to the flavor.","tastingNote":"Cinnamon, Aromatic, Korean Dessert","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/6c062978-cc0a-47d4-b472-6925aba7efdc-1774586563465.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":[],"links":[]},{"id":"120a4f1a-46c5-4d93-9859-a416c023d7b0","slug":"mint-chocolate-flavor","name":"Mint Chocolate Flavor","price":17900,"description":"Cool mint and rich chocolate come together with smooth coffee in this mix. The sweetness of chocolate stands out more than the sharpness of mint, making it enjoyable even for those who don't usually like mint chocolate.\nWith hints reminiscent of hot chocolate, it's a comforting and indulgent mix coffee.","tastingNote":"Mint Chocolate, Refreshing, Love or Hate","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/120a4f1a-46c5-4d93-9859-a416c023d7b0.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/12177710170"},{"label":"amazon","url":"https://a.co/d/0aGpGT2O"}]},{"id":"f9fd3997-2c2e-41ab-98eb-03c290bfa816","slug":"melon-ice-cream-flavor","name":"Melon Ice Cream Flavor","price":19900,"description":"The iconic Korean melon bar meets mix coffee in this refreshing blend. Its sweet, subtle melon flavor is captured just as you remember it.\nAs one of newmix's signature summer flavors, it's especially enjoyable when served cold.","tastingNote":"Fruity, Creamy, Joyful","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/f9fd3997-2c2e-41ab-98eb-03c290bfa816-1774586410138.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":["Hannam"],"links":[]},{"id":"fe1966df-66b4-4215-b1a0-a65c4fbc321d","slug":"coconut-latte-flavor","name":"Coconut Latte Flavor","price":19900,"description":"A rich and creamy coconut latte meets smooth mix coffee, bringing a tropical twist to every sip. If you enjoy bold, nutty coconut flavors, this one is sure to be a favorite.","tastingNote":"Rich, Creamy, Nutty","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/fe1966df-66b4-4215-b1a0-a65c4fbc321d-1774586416188.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":["Hannam"],"links":[]},{"id":"fd961a38-c791-401d-98c5-afec355322b4","slug":"strawberry-cream-cheese-flavor","name":"Strawberry Cream Cheese Flavor","price":19900,"description":"Fresh strawberry and smooth cream cheese come together with mix coffee. Its creamy texture and refined sweetness bring to mind an elegant strawberry dessert. If you love strawberry desserts, this is a mix coffee you're bound to fall for.","tastingNote":"Extra Creamy, Bright, Indulgent","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/fd961a38-c791-401d-98c5-afec355322b4-1788401505370.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":false,"exclusiveStores":["Seongsu"],"links":[]},{"id":"52886a11-84e4-45b7-b0a5-f729e24887bc","slug":"durian-flavor","name":"Durian Flavor","price":17900,"description":"Durian, known as the king of fruits, meets mix coffee. We brought out durian's signature creaminess, giving it a bold character you'll recognize the moment you catch its aroma. If you love durian, you're bound to fall for this nutty durian mix coffee.","tastingNote":"Nutty, Buttery, Savory","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/52886a11-84e4-45b7-b0a5-f729e24887bc-1785229756264.webp","categoryId":"0f44df6e-8ad2-44fe-8142-d3f943d3eb86","categorySlug":"mix-coffee","isSeasonal":true,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/13688012973"}]}],"non-coffee":[{"id":"0698cfb9-4970-4cbd-96eb-35d187a7ceab","slug":"earl-grey-milk-tea","name":"Earl Grey Milk Tea","price":17900,"description":"A deep and comforting milk tea made with rich Earl Grey and creamy milk. If you enjoy tea or love milk tea, this is a flavor you will absolutely love.\nThis one is also completely coffee-free.","tastingNote":"Velvety, Aromatic, Elegant","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/0698cfb9-4970-4cbd-96eb-35d187a7ceab-1774586284562.webp","categoryId":"d827bec8-0b27-430e-889b-aaf26a4614ff","categorySlug":"non-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/13099616199"}]},{"id":"7bedbcd6-cd00-4fa4-a702-df5256a8b02a","slug":"jasmine-milk-tea","name":"Jasmine Milk Tea","price":17900,"description":"A milk tea made with fragrant jasmine and creamy milk. It's floral and bright, with a gentle sweetness. If you drink milk tea often, this is one to try.","tastingNote":"Floral, Fragrant, Silky","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/7bedbcd6-cd00-4fa4-a702-df5256a8b02a-1789790589599.webp","categoryId":"d827bec8-0b27-430e-889b-aaf26a4614ff","categorySlug":"non-coffee","isSeasonal":false,"exclusiveStores":[],"links":[]},{"id":"dbd5e5c0-527c-4c68-a95f-ef8fdf7d7f60","slug":"chocolate-banana","name":"Chocolate Banana","price":17900,"description":"Rich chocolate meets creamy banana milk in this playful, dessert-like blend. It tastes just like a banana split in a cup — sweet, smooth, and a little bit nostalgic. This one is completely coffee-free.","tastingNote":"Banana Split, Creamy, Playful","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/dbd5e5c0-527c-4c68-a95f-ef8fdf7d7f60-1777559416015.webp","categoryId":"d827bec8-0b27-430e-889b-aaf26a4614ff","categorySlug":"non-coffee","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/13514392963"}]},{"id":"9a1c86ea-745f-4d5c-9187-a63dd8a4d6c0","slug":"hojicha-milk-tea","name":"Hojicha Milk Tea","price":17900,"description":"The toasty, nutty flavor of hojicha meets smooth milk — one for anyone who likes nutty flavors. Enjoy it hot or iced.","tastingNote":"Toasty, Nutty, Comforting","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/9a1c86ea-745f-4d5c-9187-a63dd8a4d6c0-1794557716354.webp","categoryId":"d827bec8-0b27-430e-889b-aaf26a4614ff","categorySlug":"non-coffee","isSeasonal":false,"exclusiveStores":[],"links":[]},{"id":"9122324e-e84f-41df-9128-daef07a09f56","slug":"black-misugaru","name":"Black Misugaru","price":19900,"description":"Black Sesame, Nutty, Nourishing","tastingNote":"Black Sesame, Nutty, Nourishing","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/9122324e-e84f-41df-9128-daef07a09f56-1794735443456.webp","categoryId":"d827bec8-0b27-430e-889b-aaf26a4614ff","categorySlug":"non-coffee","isSeasonal":false,"exclusiveStores":["Anguk"],"links":[]}],"snacks":[{"id":"526da2be-e974-4bd1-a174-fb23b2b4eda1","slug":"geonobang-crunch","name":"newmix Geonbbang Crunch","price":14500,"description":"Geonbbang, well known as a Korean military treat, has been transformed into a sweet dessert.\nCrisp, nutty Geonbbangs are coated with coffee and maple flavors, making them hard to put down. Each pack is individually wrapped, making it easy to share with friends and those around you.","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/snacks/526da2be-e974-4bd1-a174-fb23b2b4eda1-1774586011632.webp","categoryId":"042ea2a1-ffd5-437c-a247-9a70d4c8bef9","categorySlug":"snacks","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/13111214186"}]},{"id":"89a93971-9f39-4d89-9428-b90e0a1aacee","slug":"jeonbyeong-black-sesame","name":"newmix Jeonbyeong Black Sesame","price":15900,"description":"Jeonbyeong is a traditional Korean rice cracker known for its crisp texture and nutty flavor. This light and savory snack is loved by all ages. It's a perfect match for a cup of mix coffee.","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/snacks/89a93971-9f39-4d89-9428-b90e0a1aacee-1774585985509.webp","categoryId":"042ea2a1-ffd5-437c-a247-9a70d4c8bef9","categorySlug":"snacks","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/11962509172"}]},{"id":"4f8c13cd-3824-4baf-a5d9-381c9149030a","slug":"jeonbyeong-seaweed","name":"newmix Jeonbyeong Seaweed","price":15900,"description":"Jeonbyeong is a traditional Korean rice cracker known for its crisp texture and nutty flavor. This light and savory snack is loved by all ages. It's a perfect match for a cup of mix coffee.","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/snacks/4f8c13cd-3824-4baf-a5d9-381c9149030a.webp","categoryId":"042ea2a1-ffd5-437c-a247-9a70d4c8bef9","categorySlug":"snacks","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/11962509172"}]}],"merchandise":[{"id":"14f6bba2-ea15-4a04-909f-1c26b0861c43","slug":"ceramic-cup","name":"newmix Ceramic Cup","price":15000,"description":"There's a saying that mix coffee tastes best when enjoyed in a small paper cup.\nnewmix has recreated the paper cup in ceramic, sized perfectly to complement mix coffee.\nWhen filled with water up to the logo inside the cup, you'll get the ideal ratio for the most delicious mix coffee.","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/merchandise/14f6bba2-ea15-4a04-909f-1c26b0861c43-1774585637209.webp","categoryId":"082cabdf-f9d5-4194-a7a4-c61665e442dc","categorySlug":"merchandise","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/10302373488"}]},{"id":"e3794fbf-dc8c-4d27-b308-b627a6eecbf4","slug":"po-keyring","name":"Po Keyring","price":18000,"description":"Po, newmix's mascot and character, comes in the form of a keyring.\nBoth Po's name and appearance were inspired by \"po,\" the Korean word for a coffee packet. Magnets in both hands allow Po to bring its hands together or hold hands with other Po friends.","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/merchandise/e3794fbf-dc8c-4d27-b308-b627a6eecbf4-1774585775093.webp","categoryId":"082cabdf-f9d5-4194-a7a4-c61665e442dc","categorySlug":"merchandise","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/13069902548"}]},{"id":"4eb5ab87-5963-4374-868e-15f97621b5a3","slug":"seongsu-tote-bag","name":"newmix Seongsu Tote Bag","price":25000,"description":"A limited-edition tote bag made exclusively for newmix Seongsu, available only at the Seongsu store.","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/merchandise/4eb5ab87-5963-4374-868e-15f97621b5a3-1774585857023.webp","categoryId":"082cabdf-f9d5-4194-a7a4-c61665e442dc","categorySlug":"merchandise","isSeasonal":false,"exclusiveStores":["Seongsu"],"links":[]},{"id":"6e5401c0-c9df-457d-9dc7-b46dc8f570ea","slug":"bukchon-tote-bag","name":"newmix Bukchon Tote Bag","price":25000,"description":"A limited-edition tote bag made exclusively for newmix Bukchon, available only at the Bukchon store.","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/merchandise/6e5401c0-c9df-457d-9dc7-b46dc8f570ea.webp","categoryId":"082cabdf-f9d5-4194-a7a4-c61665e442dc","categorySlug":"merchandise","isSeasonal":false,"exclusiveStores":["Anguk"],"links":[]},{"id":"62f81376-9347-4dc6-bb4f-b9fb5b0fab04","slug":"mini-mug-set-for-mix-coffee","name":"Mini Mug Set for Mix Coffee","price":25000,"description":"The Mini Mug Set for mix coffee, created by Studio Torim and newmix, is a ceramic set designed specifically for enjoying a cup of newmix. The mini mug is crafted to perfectly match the ideal water ratio for a cup of newmix. The saucer can be used as a mug rest, but it's also perfect for holding snacks to pair with your coffee.","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/merchandise/62f81376-9347-4dc6-bb4f-b9fb5b0fab04-1774585866261.webp","categoryId":"082cabdf-f9d5-4194-a7a4-c61665e442dc","categorySlug":"merchandise","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/12243341734"}]},{"id":"55b6327d-adbd-4497-a63b-0e47ef101b8b","slug":"maziuntitled-x-newmix-roam-pack","name":"MAZIUNTITLED x newmix Roam Pack","price":84000,"description":"MAZIUNTITLED and newmix teamed up on a daily outdoor backpack made for city travelers. Light, easy to carry, and ready for wherever the day takes you. Comes with a free Po keyring.","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/merchandise/55b6327d-adbd-4497-a63b-0e47ef101b8b-1777428343998.webp","categoryId":"082cabdf-f9d5-4194-a7a4-c61665e442dc","categorySlug":"merchandise","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/12936540338"}]},{"id":"40c47469-a7ba-408e-9a6b-c9b646a65ac1","slug":"maziuntitled-x-newmix-small-post-bag","name":"MAZIUNTITLED x newmix Small Post Bag","price":69000,"description":"MAZIUNTITLED and newmix teamed up on a Small Post Bag made for city wanderers. Light, easy to carry, and ready for wherever the day takes you. Comes with a free Po keyring.","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/merchandise/40c47469-a7ba-408e-9a6b-c9b646a65ac1-1777428816710.webp","categoryId":"082cabdf-f9d5-4194-a7a4-c61665e442dc","categorySlug":"merchandise","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/12936544399"}]}],"retired-product":[{"id":"676ff19c-378a-4d29-a7fd-26e92ffea3bb","slug":"red-bean-bingsu-flavor","name":"Red Bean Bingsu Flavor","price":15900,"description":"When you think of \"summer in Korea,\" red bean bingsu is a dessert that can't be missed. This mix coffee combines the flavors of red bean bingsu with mix coffee.\nIt offers a nutty taste with a gently spreading sweetness that's truly appealing. Recommended for anyone who loves red bean desserts—and delicious both hot and cold.","tastingNote":"Sweet Red Bean, Nutty, Korean Dessert","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/retired-product/676ff19c-378a-4d29-a7fd-26e92ffea3bb-1774586212489.webp","categoryId":"b7b1a47d-dbec-4034-95cb-a5f809297960","categorySlug":"retired-product","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/10739705247"}]},{"id":"42da5a82-108e-4513-8f3c-69953f44cd35","slug":"white-berry-mocha","name":"White Berry Mocha Flavor","price":0,"description":"Released as a limited edition for the 2025 winter holiday season, this mix coffee offers a festive twist. It blends rich, creamy white chocolate with a bright touch of raspberry for a uniquely balanced flavor.","tastingNote":"Raspberry, White Chocolate, Festive","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/retired-product/42da5a82-108e-4513-8f3c-69953f44cd35-1774586217335.webp","categoryId":"b7b1a47d-dbec-4034-95cb-a5f809297960","categorySlug":"retired-product","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/12649574856"}]},{"id":"f2173223-c273-4ddb-8bd7-87a9361079b4","slug":"raspberry-matcha","name":"Raspberry Matcha","price":17900,"description":"Rich, smooth matcha latte paired with bright raspberry creates a special combination you won't find anywhere else. Released as a spring limited edition, it's filled with the spirit of the season. This is a non-coffee product, perfect for those who love matcha and fresh, vibrant flavors.","tastingNote":"Refreshing, Delicate, Lively","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/f2173223-c273-4ddb-8bd7-87a9361079b4-1742134085.webp","categoryId":"b7b1a47d-dbec-4034-95cb-a5f809297960","categorySlug":"retired-product","isSeasonal":true,"exclusiveStores":[],"links":[]},{"id":"cbb6f067-5290-4cc4-83ba-84db0fc41b7a","slug":"taro-milk-tea","name":"Taro Milk Tea","price":17900,"description":"This purple milk tea is enriched with the nutty, creamy flavor of taro. Smooth like butter, it also carries the subtle yet earthy depth. Released as a limited edition, this special drink is perfect to enjoy like a dessert.","tastingNote":"Creamy, Buttery, Nutty","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/cbb6f067-5290-4cc4-83ba-84db0fc41b7a-1773978428609.webp","categoryId":"b7b1a47d-dbec-4034-95cb-a5f809297960","categorySlug":"retired-product","isSeasonal":true,"exclusiveStores":[],"links":[]},{"id":"a7b0cfbb-eb77-460b-80a1-fe0319ed1e2b","slug":"boribori-bar-with-maison-mo-3ea","name":"BoriBori Bar with Maison M.O 3ea","price":10000,"description":"BoriBori Bar is a dessert made in collaboration with Maison M.O, a specialty brand known for its fine confections.\nIt combines a traditional Korean barley snack coated in premium chocolate. The bar comes in three unique flavors—Banana Coffee, Melon Coffee, and Salted Chocolate—offering a playful yet refined tasting experience.","tastingNote":null,"imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/snacks/a7b0cfbb-eb77-460b-80a1-fe0319ed1e2b-1774586001889.webp","categoryId":"b7b1a47d-dbec-4034-95cb-a5f809297960","categorySlug":"retired-product","isSeasonal":false,"exclusiveStores":[],"links":[]},{"id":"f3e12476-cee6-4ed8-8f6e-eb6737c8da54","slug":"lovely-strawberry","name":"Lovely Strawberry","price":17900,"description":"A sweet and refreshing strawberry milk with real bits of strawberry chunks. The fruitiness comes through with a soft, milky finish. This one is completely coffee-free.","tastingNote":"Strawberry Milk, Refreshing, Cute and Lovely","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/f3e12476-cee6-4ed8-8f6e-eb6737c8da54-1777559195993.webp","categoryId":"b7b1a47d-dbec-4034-95cb-a5f809297960","categorySlug":"retired-product","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/13514065951"}]},{"id":"bbc8fd2a-00c9-4505-8b92-4726eaf2416d","slug":"black-misugaru","name":"Black Misugaru","price":17900,"description":"A flavor born from a collaboration with INAPSQUARE. Inspired by INAPSQUARE's signature black-and-white illustrations and newmix's black, this menu brings together misugaru—a traditional Korean grain drink—and playful illustration.","tastingNote":"Black Sesame, Nutty, Nourishing","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/bbc8fd2a-00c9-4505-8b92-4726eaf2416d-1779156067580.webp","categoryId":"b7b1a47d-dbec-4034-95cb-a5f809297960","categorySlug":"retired-product","isSeasonal":true,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/13527460897"}]},{"id":"86920eb0-dc87-44a2-a692-15ed98d7323b","slug":"birthday-party-vanilla-flavor","name":"Birthday Party Vanilla Flavor","price":15900,"description":"Birthday Party Vanilla Flavor is inspired by the classic vanilla cake that's never missing from a birthday party. Its smooth, rich vanilla aroma brings back the joy of being celebrated on your special day. It was created with the idea of a happy flavor everyone can enjoy together in a moment of celebration. Especially recommended for those who love vanilla lattes.","tastingNote":"Vanilla Cake, Comforting, Celebration and Happiness","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/mix-coffee/86920eb0-dc87-44a2-a692-15ed98d7323b-1774586378403.webp","categoryId":"b7b1a47d-dbec-4034-95cb-a5f809297960","categorySlug":"retired-product","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/10739724868"}]},{"id":"676e8e3b-044c-4afe-971c-0be3c0e22bfc","slug":"japangi-milk","name":"Japangi Milk","price":15900,"description":"In Korea, vending machines once offered a drink called \"Japangi(vending machine) milk.\"\nIt was a sweet treat enjoyed by both children and adults who didn't drink coffee.\nnewmix Japangi Milk recreates the nostalgic flavor many Koreans remember from buying milk at vending machines as kids.\nSmooth and gently sweet, it delivers a warm sense of comfort in every sip.","tastingNote":"Sweetened Milk, Nostalgic, Non-Caffeine","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/676e8e3b-044c-4afe-971c-0be3c0e22bfc-1774586262980.webp","categoryId":"b7b1a47d-dbec-4034-95cb-a5f809297960","categorySlug":"retired-product","isSeasonal":false,"exclusiveStores":[],"links":[{"label":"amazon","url":"https://a.co/d/0g18YoRg"}]},{"id":"2774d803-a06a-4dbd-8969-fc1b0861bd2e","slug":"hojicha-milk-tea","name":"Hojicha Milk Tea","price":21900,"description":"A milk tea made in collaboration with Noritake. The toasty, nutty flavor of hojicha meets smooth milk — one for anyone who likes nutty flavors. The Noritake package is available for a limited time only.","tastingNote":"Toasty, Nutty, Comforting","imageUrl":"https://jrvntmgnjcshlfmjsmkd.supabase.co/storage/v1/object/public/products/non-coffee/2774d803-a06a-4dbd-8969-fc1b0861bd2e-1790658926194.webp","categoryId":"b7b1a47d-dbec-4034-95cb-a5f809297960","categorySlug":"retired-product","isSeasonal":true,"exclusiveStores":[],"links":[{"label":"naver","url":"https://brand.naver.com/newmixcoffee/products/13778461332"}]}]},"allProducts":["$5:props:productsByCategory:merchandise:0","$5:props:productsByCategory:snacks:0","$5:props:productsByCategory:retired-product:0","$5:props:productsByCategory:retired-product:1","$5:props:productsByCategory:non-coffee:0","$5:props:productsByCategory:mix-coffee:0","$5:props:productsByCategory:snacks:1","$5:props:productsByCategory:merchandise:1","$5:props:productsByCategory:merchandise:2","$5:props:p